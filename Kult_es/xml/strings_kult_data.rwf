	&lt;string name="XP_NOT_OWNER"&gt;Solo puede elegir avances quien pueda editar el personaje.&lt;/string&gt;
	&lt;string name="XP_EXHAUSTED"&gt;Ya se han usado todas las casillas de esta opción.&lt;/string&gt;
	&lt;string name="XP_LOCKED"&gt;Disponible tras %d avances.&lt;/string&gt;
