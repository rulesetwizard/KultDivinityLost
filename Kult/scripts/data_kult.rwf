<DocumentElement xmlns="http://tempuri.org/Ruleset.xsd">
  <Scripts>
    <ScriptName>data_kult</ScriptName>
    <FolderID>4</FolderID>
    <Script>local moves = {
  ["Keep it Together"] = {attribute="willpower"},
  ["Endure Injury"] = {attribute="fortitude"},
  ["Avoid Harm"] = {attribute="reflexes"},
  ["Investigate"] = {attribute="reason"},
  ["Read a Person"] = {attribute="intuition"},
  ["Observe a situation"] = {attribute="perception"},
  ["Act Under Pressure"] = {attribute="coolness"},
  ["Engage in Combat"] = {attribute="violence"},
  ["Influence Other"] = {attribute="charisma"},
  ["See Through the Illusion"] = {attribute="soul"},
  ["Helping or Hindering"] = {attribute=""},
}

function getMoves()
    return moves;
end</Script>
    <RegisterScript>true</RegisterScript>
    <Encoding />
  </Scripts>
</DocumentElement>