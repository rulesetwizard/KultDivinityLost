<DocumentElement xmlns="http://tempuri.org/Ruleset.xsd">
  <Scripts>
    <ScriptName>manager_kult</ScriptName>
    <FolderID>0</FolderID>
    <Script>
local aAttributeKeys = { "willpower", "fortitude", "reflexes", "reason", "intuition", "perception", "coolness", "violence", "charisma", "soul" };

-- Help or Hinder move names, besides the one in the active language (older sheets kept these)
local aHelpHinderNames = { "helping or hindering", "ayudar o interferir" };

-- Roll types generated by Ruleset Wizard for the attributes and the move/trait buttons
local aRollTypes = { "btnRollRollAction", "willpowerRollAction", "reflexesRollAction", "fortitudeRollAction", "intuitionRollAction",
	"reasonRollAction", "perceptionRollAction", "violenceRollAction", "coolnessRollAction", "charismaRollAction", "soulRollAction" };

function onInit()
	CombatRecordManager.setRecordTypePostAddCallback("npc", onNPCPostAdd);
	for _,sType in ipairs(aRollTypes) do
		ActionsManager.registerModHandler(sType, modRoll);
	end
end

function onNPCPostAdd(tCustom)
	if not tCustom.nodeRecord or not tCustom.nodeCT then
		return;
	end
	DB.setValue(tCustom.nodeCT, 'maxWounds', 'number', DB.getValue(tCustom.nodeCT, 'wounds', 0));
	DB.setValue(tCustom.nodeCT, 'wounds', 'number', 0);
end

-- Attributes: the key is the charsheet field; the name comes from the attribute_&lt;key&gt; string
function getAttributeKeys()
	return aAttributeKeys;
end

function getAttributeName(sKey)
	return Interface.getString("attribute_" .. sKey);
end

-- Accepts a key, the English name or the name in the active language
function getAttributeKey(sAttribute)
	if (sAttribute or "") == "" then
		return nil;
	end
	local sLower = sAttribute:lower();
	for _,sKey in ipairs(aAttributeKeys) do
		if sLower == sKey or sAttribute == getAttributeName(sKey) then
			return sKey;
		end
	end
	return nil;
end

function getAttributeRollDesc(sKey)
	return string.format(Interface.getString("ROLL_ATTRIBUTE"), getAttributeName(sKey));
end

function isHelpHinderMove(sName)
	if (sName or "") == "" then
		return false;
	end
	local sLower = trim(sName):lower();
	if sLower == Interface.getString("Helping or Hindering"):lower() then
		return true;
	end
	for _,sHelpHinder in ipairs(aHelpHinderNames) do
		if sLower == sHelpHinder then
			return true;
		end
	end
	return false;
end

-- Stability: 1 Composed ... 10 Broken (empty also means Composed)
function getStressLevel(nStability)
	if not nStability then
		return "";
	end
	if nStability &gt;= 10 then
		return "BROKEN";
	elseif nStability &gt;= 7 then
		return "CRITICAL_STRESS";
	elseif nStability &gt;= 4 then
		return "SERIOUS_STRESS";
	elseif nStability &gt;= 2 then
		return "MODERATE_STRESS";
	end
	return "";
end

-- Returns the Keep it Together, Disadvantage roll and See Through the Illusion modifiers
function getStressModifiers(nStability)
	local sLevel = getStressLevel(nStability);
	if sLevel == "CRITICAL_STRESS" then
		return -2, -3, 1;
	elseif sLevel == "SERIOUS_STRESS" then
		return -1, -2, 0;
	elseif sLevel == "MODERATE_STRESS" then
		return 0, -1, 0;
	end
	return 0, 0, 0;
end

-- Kult modifiers of a roll: a list of { sLabel, nValue }.
-- Help or Hinder uses the attribute of the other PC's move, so the attribute's own rules do not apply.
-- nHarm and nArmor come from the roll setup window; without them Endure Injury uses the sheet armor and no Harm.
function getRollModifiers(charNode, sAttribute, bDisadvantage, bHelpHinder, nHarm, nArmor)
	local aMods = {};

	local bSeriousWound = false;
	for i = 1, 4 do
		if (trim(DB.getValue(charNode, "wound" .. i, '')) ~= "") and (DB.getValue(charNode, "wound" .. i .. "sta", 0) == 0) then
			bSeriousWound = true;
		end
	end
	if bSeriousWound then
		table.insert(aMods, { sLabel = Interface.getString("WOUNDED"), nValue = -1 });
	end

	-- A stabilized critical wound counts as a stabilized serious wound
	if (trim(DB.getValue(charNode, "criticalwound", '')) ~= "") and (DB.getValue(charNode, "CriticalWoundStabilized", 0) == 0) then
		table.insert(aMods, { sLabel = Interface.getString("CRITICAL"), nValue = -1 });
	end

	local sAttributeKey = nil;
	if not bHelpHinder then
		sAttributeKey = getAttributeKey(sAttribute);
	end

	-- Endure Injury (the only Fortitude move): +armor -Harm
	if sAttributeKey == "fortitude" then
		local nArmorValue = nArmor or DB.getValue(charNode, "armor", 0);
		if nArmorValue ~= 0 then
			table.insert(aMods, { sLabel = Interface.getString("ARMOR"), nValue = nArmorValue });
		end
		if (nHarm or 0) ~= 0 then
			table.insert(aMods, { sLabel = Interface.getString("HARM"), nValue = -nHarm });
		end
	end

	local nKeepItTogether, nDisadvantage, nSeeThrough = getStressModifiers(tonumber(DB.getValue(charNode, "stability", "")));
	local nStabilityMod = 0;
	if sAttributeKey == "willpower" then
		nStabilityMod = nStabilityMod + nKeepItTogether;
	end
	if sAttributeKey == "soul" then
		nStabilityMod = nStabilityMod + nSeeThrough;
	end
	if bDisadvantage then
		nStabilityMod = nStabilityMod + nDisadvantage;
	end
	if nStabilityMod ~= 0 then
		table.insert(aMods, { sLabel = Interface.getString("STABILITY"), nValue = nStabilityMod });
	end

	return aMods;
end

function signed(n)
	if n &gt;= 0 then
		return "+" .. n;
	end
	return tostring(n);
end

-- The total modifier before rolling and its parts, for tooltips and the roll setup window
function getRollPreview(charNode, sAttribute, bDisadvantage, bHelpHinder, nHarm, nArmor)
	if not charNode then
		return "";
	end
	local sKey = getAttributeKey(sAttribute);
	if bHelpHinder and not sKey then
		return Interface.getString("HELP_HINDER_NO_ATTRIBUTE");
	end
	local nTotal = 0;
	local aParts = {};
	if sKey then
		nTotal = DB.getValue(charNode, sKey, 0);
		table.insert(aParts, getAttributeName(sKey) .. " " .. signed(nTotal));
	end
	local aMods = getRollModifiers(charNode, sAttribute, bDisadvantage, bHelpHinder, nHarm, nArmor);
	for _,rMod in ipairs(aMods) do
		nTotal = nTotal + rMod.nValue;
		table.insert(aParts, rMod.sLabel .. " " .. signed(rMod.nValue));
	end
	local sPreview = "2d10 " .. signed(nTotal);
	if #aParts &gt; 0 then
		sPreview = sPreview .. "\n" .. table.concat(aParts, "; ");
	end
	return sPreview .. "\n" .. Interface.getString("ROLL_PREVIEW_MODSTACK");
end

-- Applies the Kult modifiers before the dice are thrown, so the roll shows them
function modRoll(rSource, rTarget, rRoll)
	local charNode = ActorManager.getCreatureNode(rSource);
	if charNode then
		local aMods = getRollModifiers(charNode, rRoll["attribute"], rRoll["disadvantage"] == "1", isHelpHinderMove(rRoll["move"]),
			tonumber(rRoll["kultharm"]), tonumber(rRoll["kultarmor"]));
		local nTotal = 0;
		local sMods = "";
		for _,rMod in ipairs(aMods) do
			nTotal = nTotal + rMod.nValue;
			sMods = sMods .. " [" .. rMod.sLabel .. " " .. signed(rMod.nValue) .. "]";
		end
		-- A roll can pass through here more than once: replace what was applied before
		rRoll.nMod = (rRoll.nMod or 0) - (tonumber(rRoll.sKultApplied) or 0) + nTotal;
		rRoll.sKultApplied = tostring(nTotal);
		rRoll.sKultDesc = rRoll.sKultDesc or rRoll.sDesc;
		rRoll.sDesc = rRoll.sKultDesc .. sMods;
	end
	-- true keeps the dice expression of Ruleset Wizard rolls ("2d10+attribute")
	return true;
end

-- Opens the roll setup window. rData: sName, sDesc, sMove ("endure", "help" or ""), sAttribute,
-- sRecord (move or trait of the sheet), aGroups (labels of a trait with several rolls), bTrait, bDisadvantage
function openRollSetup(nodeChar, rData)
	local w = Interface.openWindow("kult_roll_setup", "");
	if w then
		w.configure(nodeChar, rData);
		-- Opened from a double click on the sheet, which gets the focus back afterwards
		w.bringToFront();
	end
end

-- The roll prepared in the setup window; modRoll adds the Kult modifiers as in any other roll
function performSetupRoll(nodeChar, rData, sAttributeKey, nHarm, nArmor, nGroup)
	local rRoll = { sType = "btnRollRollAction", sDesc = rData.sDesc or (Interface.getString("ROLL_MOVE") .. " " .. rData.sName),
		aDice = { "d10", "d10" }, nMod = 0, attribute = sAttributeKey or "" };
	if sAttributeKey then
		rRoll.nMod = DB.getValue(nodeChar, sAttributeKey, 0);
	end
	if not rData.bTrait then
		rRoll.move = rData.sName;
	end
	if rData.sRecord then
		rRoll.kultrecord = rData.sRecord;
	end
	if nGroup then
		rRoll.kultresult = tostring(nGroup);
	end
	if rData.bDisadvantage then
		rRoll.disadvantage = "1";
	end
	if nHarm then
		rRoll.kultharm = tostring(nHarm);
		rRoll.kultarmor = tostring(nArmor or 0);
	end
	ActionsManager.performAction(nil, ActorManager.resolveActor(nodeChar), rRoll);
end

function findMove(charNode, sName)
	for _,node in pairs(DB.getChildren(charNode, "moveslist")) do
		if trim(DB.getValue(node, "name", "")) == trim(sName) then
			return node;
		end
	end
	return nil;
end

-- The move or trait of the sheet whose description holds the results of the roll
function getRollRecord(charNode, rRoll)
	local sRecord = rRoll["kultrecord"] or "";
	if sRecord ~= "" then
		-- Only records of the character that rolls
		local sPrefix = DB.getPath(charNode) .. ".";
		if sRecord:sub(1, #sPrefix) == sPrefix then
			return DB.findNode(sRecord);
		end
		return nil;
	end
	if (rRoll["move"] or "") ~= "" then
		return findMove(charNode, rRoll["move"]);
	end
	-- An attribute roll of the sheet is the basic move of that attribute
	if rRoll.sType ~= "btnRollRollAction" then
		local sKey = getAttributeKey(rRoll["attribute"]);
		for sName, rMove in pairs(data_kult.getMoves()) do
			if sKey and getAttributeKey(rMove.attribute) == sKey then
				return findMove(charNode, Interface.getString(sName)) or findMove(charNode, sName);
			end
		end
	end
	return nil;
end

function resolveRoll(rSource, rTarget, rRoll)

    local rMessage = ActionsManager.createActionMessage(rSource, rRoll);
    
	local total = ActionsManager.total(rRoll); -- the total FG shows in chat (dice, fixed bonus and modifiers)
	local sHelpHinder = "HELP_HINDER_MISS";
    if total &gt;= 15 then
		rMessage.text = rMessage.text .. ' [' .. Interface.getString("COMPLETE SUCCESS") .. ']';
		sHelpHinder = "HELP_HINDER_FULL";
    else
		if total &gt;= 10 then
			rMessage.text = rMessage.text .. ' [' .. Interface.getString("SUCCESS WITH COMPLICATIONS") .. ']';
			sHelpHinder = "HELP_HINDER_PARTIAL";
		else
			rMessage.text = rMessage.text .. ' [' .. Interface.getString("FAILURE") .. ']';
		end
	end
	if isHelpHinderMove(rRoll["move"]) then
		rMessage.text = rMessage.text .. ' [' .. Interface.getString(sHelpHinder) .. ']';
	end

	-- The result text of the move or trait, taken from its description
	local charNode = ActorManager.getCreatureNode(rSource);
	if charNode then
		local sResult, sContext = kult_results.getResult(getRollRecord(charNode, rRoll), total, tonumber(rRoll["kultresult"]));
		if sResult then
			if sContext then
				rMessage.text = rMessage.text .. "\n" .. sContext;
			end
			rMessage.text = rMessage.text .. "\n" .. sResult;
		end
	end
	
    Comm.deliverChatMessage(rMessage);    
end

function trim(s)
   return s:match "^%s*(.-)%s*$"
end
</Script>
    <RegisterScript>true</RegisterScript>
    <Encoding />
  </Scripts>
</DocumentElement>