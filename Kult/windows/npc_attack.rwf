    <LUACode>-- An attack of an NPC (kult_npc), parsed from its "attacks" text. Sourceless: the list rebuilds it when the text changes.
-- Double click posts it to the chat; dragging it drags its Harm onto a target.
local sNodePath = "";
local rAttack = nil;

function setAttack(nodeNPC, rData)
	sNodePath = DB.getPath(nodeNPC);
	rAttack = rData;
	text.setValue(kult_npc.getAttackText(rData));
	local sTooltip = Interface.getString("NPC_ATTACK_TOOLTIP");
	text.setTooltipText(sTooltip);
	btnPost.setTooltipText(sTooltip);
end

function post()
	kult_npc.postAttack(DB.findNode(sNodePath), rAttack);
end

function drag(draginfo)
	return kult_npc.fillHarmDrag(draginfo, DB.findNode(sNodePath), rAttack);
end
</LUACode>
