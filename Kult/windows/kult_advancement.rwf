    <LUACode>-- Confirms an advancement of the XP tab: its 5 XP and, for attribute options, which attribute rises.
-- The controls are sourceless; kult_xp.applyAdvance checks everything again when it is applied.
-- Apply starts hidden: refresh shows it once the window is configured.
local sCharPath = "";
local nOption = nil;
local bApplied = false;

function configure(nodeChar, nId)
	sCharPath = DB.getPath(nodeChar);
	nOption = tonumber(nId);
	bApplied = false;
	local rOption = kult_xp.getOption(nOption);
	if not rOption then
		close();
		return;
	end
	title.setValue(kult_xp.getOptionName(rOption));
	hint.setValue(Interface.getString("XP_HINT_" .. rOption.nId));

	local bAttribute = (rOption.sGroup ~= nil);
	lblAttribute.setVisible(bAttribute);
	attribute.setVisible(bAttribute);
	attribute.clear(true);
	if bAttribute then
		local aItems = {};
		for _,sKey in ipairs(kult_xp.getAllowedAttributes(rOption)) do
			local nValue = DB.getValue(nodeChar, sKey, 0);
			table.insert(aItems, { sValue = sKey, sText = manager_kult.getAttributeName(sKey) .. " (" .. manager_kult.signed(nValue) .. ")" });
		end
		attribute.addItems(aItems);
	end
	refresh();
end

function refresh()
	local nodeChar = DB.findNode(sCharPath);
	local rOption = kult_xp.getOption(nOption);
	if not nodeChar or not rOption then
		return;
	end
	local bOk, sMessage = kult_xp.getAvailability(nodeChar, nOption);
	if bOk and rOption.sGroup then
		local sKey = attribute.getValue();
		local nAfter, sError = kult_xp.checkAttribute(nodeChar, rOption, sKey);
		if nAfter then
			sMessage = kult_xp.getAttributeChange(sKey, nAfter - 1, nAfter) .. "\n" .. sMessage;
		else
			bOk = false;
			sMessage = sError;
		end
	end
	preview.setValue(sMessage);
	btnApply.setVisible(bOk and not bApplied);
end

function perform()
	local nodeChar = DB.findNode(sCharPath);
	if bApplied or not nodeChar or not nOption then
		return;
	end
	local bOk, sMessage = kult_xp.applyAdvance(nodeChar, nOption, attribute.getValue());
	if bOk then
		bApplied = true;
		close();
	else
		preview.setValue(sMessage);
		btnApply.setVisible(false);
	end
end
</LUACode>
