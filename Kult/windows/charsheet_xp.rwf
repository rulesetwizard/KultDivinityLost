    <LUACode>-- Advancements are chosen with their buttons, which pay the 5 XP and apply them (kult_xp); the boxes are
-- read-only so they cannot be marked without paying. "Edit boxes" allows manual corrections.
local bEditHistory = false;
local sCountsBefore = "";
local aWatched = {};

function onInit()
	local node = getDatabaseNode();
	-- Older sheets had 3 boxes for the second Advantage advancement (Aware archetypes have 2)
	if DB.isOwner(node) and DB.getValue(node, "adv6_max", 2) &gt; 2 then
		DB.setValue(node, "adv6_max", "number", math.max(2, DB.getValue(node, "adv6_current", 0)));
	end

	local aFields = { "experiencePoints" };
	for _,rOption in ipairs(kult_xp.getOptions()) do
		table.insert(aFields, kult_xp.getCountField(rOption));
	end
	for _,sKey in ipairs(manager_kult.getAttributeKeys()) do
		table.insert(aFields, sKey);
	end
	for _,sField in ipairs(aFields) do
		local sPath = DB.getPath(node, sField);
		DB.addHandler(sPath, "onUpdate", refresh);
		table.insert(aWatched, sPath);
	end
	refresh();
end

function onClose()
	for _,sPath in ipairs(aWatched) do
		DB.removeHandler(sPath, "onUpdate", refresh);
	end
end

function refresh()
	local node = getDatabaseNode();
	if not node then
		return;
	end
	local bOwner = DB.isOwner(node);
	local nTotal = kult_xp.getTotal(node);
	lblTotal.setValue(string.format(Interface.getString("XP_TOTAL"), nTotal));
	for _,rOption in ipairs(kult_xp.getOptions()) do
		local bOk, sMessage = kult_xp.getAvailability(node, rOption.nId);
		local btnChoose = self["btnChoose" .. rOption.nId];
		btnChoose.setVisible(bOwner and not bEditHistory);
		btnChoose.setEnabled(bOk);
		btnChoose.setTooltipText(sMessage);
		self["adv" .. rOption.nId].setReadOnly(not (bOwner and bEditHistory));
	end
	setUnlockText(lblUnlock5, 5, nTotal);
	setUnlockText(lblUnlock10, 10, nTotal);

	local bCanUndo = kult_xp.canUndo(node);
	btnUndo.setVisible(bOwner and not bEditHistory);
	btnUndo.setEnabled(bCanUndo);
	if bCanUndo then
		btnUndo.setTooltipText(kult_xp.getLastAdvanceText(node));
	else
		btnUndo.setTooltipText(Interface.getString("XP_CANNOT_UNDO"));
	end
	btnEditHistory.setVisible(bOwner);
	if bEditHistory then
		btnEditHistory.setText(Interface.getString("ATTRIBUTES_DONE"));
		lblXPNote.setValue(Interface.getString("XP_NOTE_EDIT"));
	else
		btnEditHistory.setText(Interface.getString("XP_EDIT_BOXES"));
		lblXPNote.setValue(string.format(Interface.getString("XP_NOTE"), kult_xp.XP_COST));
	end
end

function setUnlockText(ctrl, nThreshold, nTotal)
	if nTotal &gt;= nThreshold then
		ctrl.setValue(Interface.getString("XP_UNLOCKED"));
	else
		ctrl.setValue(string.format(Interface.getString("XP_REMAINING"), nThreshold - nTotal));
	end
end

function chooseAdvance(nId)
	kult_xp.openAdvancement(getDatabaseNode(), nId);
end

local function getCounts(node)
	local aCounts = {};
	for _,rOption in ipairs(kult_xp.getOptions()) do
		table.insert(aCounts, kult_xp.getUsed(node, rOption));
	end
	return table.concat(aCounts, ",");
end

-- Manual corrections do not spend or return XP; if they change the boxes, the undo history no longer applies
function toggleEditHistory()
	local node = getDatabaseNode();
	if not DB.isOwner(node) then
		return;
	end
	if bEditHistory then
		bEditHistory = false;
		if getCounts(node) ~= sCountsBefore then
			kult_xp.clearHistory(node);
		end
	else
		bEditHistory = true;
		sCountsBefore = getCounts(node);
	end
	refresh();
end
</LUACode>
