    <LUACode>-- Prepares a roll that needs data the sheet does not have: the Harm of Endure Injury or the attribute of Help or Hinder.
-- The controls are sourceless: nothing typed here is stored on the character.
local sCharPath = "";
local rSetup = nil;

function configure(nodeChar, rData)
	sCharPath = DB.getPath(nodeChar);
	rSetup = rData;
	title.setValue(rData.sName);

	local bEndure = (rData.sMove == "endure");
	lblAttribute.setVisible(not bEndure);
	attribute.setVisible(not bEndure);
	lblHarm.setVisible(bEndure);
	harm.setVisible(bEndure);
	lblArmor.setVisible(bEndure);
	armor.setVisible(bEndure);

	attribute.setValue(manager_kult.getAttributeKey(rData.sAttribute) or "");
	harm.setValue(0);
	armor.setValue(DB.getValue(nodeChar, "armor", 0));
	refresh();
end

function getAttribute()
	if rSetup and rSetup.sMove == "endure" then
		return "fortitude";
	end
	return attribute.getValue();
end

function refresh()
	if not rSetup then
		return;
	end
	local sKey = manager_kult.getAttributeKey(getAttribute());
	local nHarm, nArmor = nil, nil;
	if rSetup.sMove == "endure" then
		nHarm = harm.getValue();
		nArmor = armor.getValue();
	end
	if sKey then
		preview.setValue(manager_kult.getRollPreview(DB.findNode(sCharPath), sKey, false, rSetup.sMove == "help", nHarm, nArmor));
	else
		preview.setValue(Interface.getString("ROLL_SETUP_CHOOSE_ATTRIBUTE"));
	end
	btnRoll.setVisible(sKey ~= nil);
end

function perform()
	local nodeChar = DB.findNode(sCharPath);
	local sKey = manager_kult.getAttributeKey(getAttribute());
	if not rSetup or not nodeChar or not sKey then
		return;
	end
	local nHarm, nArmor = nil, nil;
	if rSetup.sMove == "endure" then
		nHarm = harm.getValue();
		nArmor = armor.getValue();
	end
	manager_kult.performSetupRoll(nodeChar, rSetup.sName, sKey, nHarm, nArmor);
	close();
end
</LUACode>
