    <LUACode>-- An advantage, disadvantage or dark secret offered by an archetype (kult_archetype_setup). Sourceless.
-- It starts checked when it comes automatically with the archetype or the sheet already has it.
local rOption = nil;

function setOption(rData, sClass, bChecked)
	rOption = rData;
	name.setValue(rData.sName);
	link.setValue(sClass, rData.sRecord);
	if rData.bFixed or bChecked then
		check.setValue(1);
	else
		check.setValue(0);
	end
	if rData.bFixed then
		check.setReadOnly(true);
		name.setTooltipText(Interface.getString("ARCH_FIXED"));
	end
end

function getOption()
	return rOption;
end

function isChecked()
	return check.getValue() == 1;
end

function onCheckChanged()
	if windowlist and windowlist.window and windowlist.window.refresh then
		windowlist.window.refresh();
	end
end
</LUACode>
