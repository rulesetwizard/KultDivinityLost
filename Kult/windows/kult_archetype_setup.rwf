    <LUACode>-- Character creation from an archetype (kult_archetype): occupation, the advantages, disadvantages and dark secrets
-- the archetype offers (with the counts its text sets) and the attribute modifiers. Sourceless: nothing is stored
-- on the character until Apply. Apply starts hidden: refresh shows it when the choice is complete.
local sCharPath = "";
local rData = nil;
local bUpdating = false;
local aClasses = { adv = "advantagedisadvantage", dis = "advantagedisadvantage", sec = "darksecret" };

local function getCategoryLabel(sCategory)
	return Interface.getString("ARCH_" .. sCategory:upper());
end

local function getChecked(sCategory)
	local aChecked = {};
	for _,w in ipairs(self["list_" .. sCategory].getWindows()) do
		if w.isChecked() then
			table.insert(aChecked, w.getOption());
		end
	end
	return aChecked;
end

local function getAttributeGroups()
	return { { kult_archetype.PASSIVE, rData.aPassivePool }, { kult_archetype.ACTIVE, rData.aActivePool } };
end

-- Names of the traits the sheet already has: advantages and disadvantages together, and dark secrets
local function getSheetTraits(nodeChar)
	local aTraits, aSecrets = {}, {};
	for _,node in pairs(DB.getChildren(nodeChar, "abilitylist")) do
		aTraits[kult_weapons.normalize(DB.getValue(node, "name", ""))] = true;
	end
	for _,node in pairs(DB.getChildren(nodeChar, "darksecrets")) do
		aSecrets[kult_weapons.normalize(DB.getValue(node, "name", ""))] = true;
	end
	return { adv = aTraits, dis = aTraits, sec = aSecrets };
end

function configure(nodeChar, rArchetype)
	sCharPath = DB.getPath(nodeChar);
	rData = rArchetype;
	title.setValue(string.format(Interface.getString("ARCH_TITLE"), rData.sName));
	lblOccupation.setValue(Interface.getString("ARCH_OCCUPATION"));
	lblAttributes.setValue(Interface.getString("ARCH_ATTRIBUTES"));
	lblPassive.setValue(Interface.getString("ARCH_PASSIVE"));
	lblActive.setValue(Interface.getString("ARCH_ACTIVE"));

	local aOccupations = { { sValue = "", sText = "" } };
	for _,sOccupation in ipairs(rData.aOccupations) do
		table.insert(aOccupations, { sValue = sOccupation, sText = sOccupation });
	end
	occupation.clear(true);
	occupation.addItems(aOccupations);
	occupation.setValue(DB.getValue(nodeChar, "occupation", ""));

	-- Options the sheet already has start checked, so the setup can be reopened
	local aHave = getSheetTraits(nodeChar);
	for _,sCategory in ipairs(kult_archetype.CATEGORIES) do
		local wList = self["list_" .. sCategory];
		wList.closeAll();
		for _,rOption in ipairs(rData.aCategories[sCategory].aOptions) do
			local w = wList.createWindow();
			if w then
				w.setOption(rOption, aClasses[sCategory], aHave[sCategory][kult_weapons.normalize(rOption.sName)] == true);
			end
		end
	end

	for _,sKey in ipairs(manager_kult.getAttributeKeys()) do
		self["lblAttr_" .. sKey].setValue(manager_kult.getAttributeName(sKey));
	end
	-- Attributes are assigned by default only on a sheet that has none yet
	if kult_archetype.hasBlankAttributes(nodeChar) then
		setAttributes.setValue(1);
	else
		setAttributes.setValue(0);
	end
	updateAttributeLists();
	refresh();
end

-- Each dropdown offers the values of its pool that the other attributes of the group have not taken
function updateAttributeLists()
	if not rData then
		return;
	end
	bUpdating = true;
	for _,aGroup in ipairs(getAttributeGroups()) do
		local aKeys, aPool = aGroup[1], aGroup[2];
		for _,sKey in ipairs(aKeys) do
			local aFree = {};
			for _,n in ipairs(aPool) do
				table.insert(aFree, n);
			end
			for _,sOther in ipairs(aKeys) do
				local nOther = tonumber(self["attr_" .. sOther].getValue());
				if sOther ~= sKey and nOther then
					for i,n in ipairs(aFree) do
						if n == nOther then
							table.remove(aFree, i);
							break;
						end
					end
				end
			end
			local aItems = { { sValue = "", sText = "" } };
			local aSeen = {};
			for _,n in ipairs(aFree) do
				if not aSeen[n] then
					aSeen[n] = true;
					table.insert(aItems, { sValue = tostring(n), sText = manager_kult.signed(n) });
				end
			end
			local cCombo = self["attr_" .. sKey];
			local sCurrent = cCombo.getValue();
			cCombo.clear(true);
			cCombo.addItems(aItems);
			cCombo.setValue(sCurrent);
		end
	end
	bUpdating = false;
end

function onAttributeSelected()
	if bUpdating then
		return;
	end
	updateAttributeLists();
	refresh();
end

-- Values of the pools not assigned yet, as text
local function getUnassigned()
	local aLeft = {};
	for _,aGroup in ipairs(getAttributeGroups()) do
		local aKeys, aPool = aGroup[1], aGroup[2];
		local aFree = {};
		for _,n in ipairs(aPool) do
			table.insert(aFree, n);
		end
		for _,sKey in ipairs(aKeys) do
			local nValue = tonumber(self["attr_" .. sKey].getValue());
			for i,n in ipairs(aFree) do
				if n == nValue then
					table.remove(aFree, i);
					break;
				end
			end
		end
		for _,n in ipairs(aFree) do
			table.insert(aLeft, manager_kult.signed(n));
		end
	end
	return aLeft;
end

function refresh()
	if not rData or bUpdating then
		return;
	end
	local aMissing = {};
	for _,sCategory in ipairs(kult_archetype.CATEGORIES) do
		local rCategory = rData.aCategories[sCategory];
		local sLabel = getCategoryLabel(sCategory);
		local nChecked = #getChecked(sCategory);
		local cLabel = self["lbl_" .. sCategory];
		if rCategory.nMin then
			local sNeed = tostring(rCategory.nMin);
			if not rCategory.nMax then
				sNeed = sNeed .. "+";
			elseif rCategory.nMax ~= rCategory.nMin then
				sNeed = sNeed .. "-" .. rCategory.nMax;
			end
			cLabel.setValue(string.format(Interface.getString("ARCH_COUNT"), sLabel, nChecked, sNeed));
			if nChecked &lt; rCategory.nMin or (rCategory.nMax and nChecked &gt; rCategory.nMax) then
				table.insert(aMissing, string.format(Interface.getString("ARCH_NEED"), sLabel, sNeed));
			end
		else
			cLabel.setValue(string.format(Interface.getString("ARCH_NO_OPTIONS"), sLabel));
		end
	end

	local bAttributes = (setAttributes.getValue() == 1);
	for _,sKey in ipairs(manager_kult.getAttributeKeys()) do
		self["lblAttr_" .. sKey].setVisible(bAttributes);
		self["attr_" .. sKey].setVisible(bAttributes);
	end
	lblPassive.setVisible(bAttributes);
	lblActive.setVisible(bAttributes);
	if bAttributes then
		local aLeft = getUnassigned();
		if #aLeft &gt; 0 then
			table.insert(aMissing, string.format(Interface.getString("ARCH_UNASSIGNED"), table.concat(aLeft, ", ")));
		end
	end

	if #aMissing &gt; 0 then
		status.setValue(table.concat(aMissing, "\n"));
	else
		status.setValue(Interface.getString("ARCH_READY"));
	end
	btnApply.setVisible(#aMissing == 0);
end

function perform()
	local nodeChar = DB.findNode(sCharPath);
	if not rData or not nodeChar then
		return;
	end
	refresh();
	if not btnApply.isVisible() then
		return;
	end
	local rChoice = { sOccupation = occupation.getValue(), aRecords = {} };
	for _,sCategory in ipairs(kult_archetype.CATEGORIES) do
		rChoice.aRecords[sCategory] = {};
		for _,rOption in ipairs(getChecked(sCategory)) do
			table.insert(rChoice.aRecords[sCategory], rOption.sRecord);
		end
	end
	if setAttributes.getValue() == 1 then
		rChoice.aAttributes = {};
		for _,sKey in ipairs(manager_kult.getAttributeKeys()) do
			rChoice.aAttributes[sKey] = tonumber(self["attr_" .. sKey].getValue()) or 0;
		end
	end
	kult_archetype.apply(nodeChar, rData, rChoice);
	close();
end
</LUACode>
    <GroupIndex>0</GroupIndex>
