    <LUACode>-- A weapon of the inventory (kult_weapons), shown on the main tab while it is equipped.
-- The windowlist creates a row for every inventory item and shows only the equipped weapons.
local sPath = "";

function onInit()
	local node = getDatabaseNode();
	sPath = DB.getPath(node);
	if kult_weapons.isWeapon(node) and DB.isOwner(node) and not DB.isReadOnly(node) then
		kult_weapons.prepare(node);
		-- The link opens the item
		local _, sRecord = DB.getValue(node, "link", "", "");
		if (sRecord or "") == "" then
			DB.setValue(node, "link", "windowreference", "item", sPath);
		end
	end
	DB.addHandler(DB.getPath(node, "ammoused"), "onUpdate", updateAmmo);
	DB.addHandler(DB.getPath(node, "ammo"), "onUpdate", updateAmmo);
	updateAmmo();
end

function onClose()
	DB.removeHandler(sPath .. ".ammoused", "onUpdate", updateAmmo);
	DB.removeHandler(sPath .. ".ammo", "onUpdate", updateAmmo);
end

function updateAmmo()
	local node = getDatabaseNode();
	btnReload.setVisible(DB.isOwner(node) and DB.getValue(node, "ammoused", 0) &gt; 0);
	local sTooltip = Interface.getString("WEAPON_ATTACK");
	local sRange = kult_weapons.getRange(node);
	if sRange ~= "" then
		sTooltip = sTooltip .. "\n" .. string.format(Interface.getString("WEAPON_RANGE"), sRange);
	end
	btnAttack.setTooltipText(sTooltip);
end
</LUACode>
