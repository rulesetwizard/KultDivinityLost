    <LUACode>-- Attributes and attacks of an NPC in the combat tracker. The attacks are parsed from its text (kult_npc):
-- double click posts one to the chat, and its Harm can be dragged onto a PC.
local sAttacksPath = "";

function onInit()
	sAttacksPath = DB.getPath(getDatabaseNode(), "attacks");
	DB.addHandler(sAttacksPath, "onUpdate", updateAttacks);
	updateAttacks();
end

function onClose()
	DB.removeHandler(sAttacksPath, "onUpdate", updateAttacks);
end

function updateAttacks()
	kult_npc.fillAttackList(attacklist, getDatabaseNode());
end
</LUACode>
