    <LUACode>
function getAttributeValue()
	local sKey = manager_kult.getAttributeKey(window.attribute.getValue());
	if sKey then
		return DB.getValue(window.windowlist.window.getDatabaseNode(), sKey, 0);
	end
	return 0;
end

-- Endure Injury, Help or Hinder and moves without attribute open the roll setup window instead of rolling.
-- The roll carries this move, whose description gives the result text.
function onBeforeDiceRoll(dragInfo)
	local sName = window.name.getValue();
	local sAttribute = window.attribute.getValue();
	local sKey = manager_kult.getAttributeKey(sAttribute);
	local nodeChar = window.windowlist.window.getDatabaseNode();
	local sRecord = DB.getPath(window.getDatabaseNode());
	local sMove = nil;
	if manager_kult.isHelpHinderMove(sName) then
		sMove = "help";
	elseif sKey == "fortitude" then
		sMove = "endure";
	elseif not sKey then
		sMove = "";
	end
	if sMove then
		manager_kult.openRollSetup(nodeChar, { sName = sName, sMove = sMove, sAttribute = sAttribute, sRecord = sRecord });
		return false;
	end
	DiceRollAdditionalInfo["kultrecord"] = sRecord;
	return true;
end

-- Tooltip with the modifier the roll will have
function onHover(bOnControl)
	if bOnControl then
		setTooltipText(manager_kult.getRollPreview(window.windowlist.window.getDatabaseNode(), window.attribute.getValue(), false, manager_kult.isHelpHinderMove(window.name.getValue())));
	end
end</LUACode>
