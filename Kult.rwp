    <LUACode>local sAttacksPath = "";

function onInit()
	self.onLockModeChanged(WindowManager.getWindowReadOnlyState(self));
	-- The attack list is parsed from the attacks text (kult_npc)
	sAttacksPath = DB.getPath(getDatabaseNode(), "attacks");
	DB.addHandler(sAttacksPath, "onUpdate", updateAttacks);
	updateAttacks();
end

function onClose()
	DB.removeHandler(sAttacksPath, "onUpdate", updateAttacks);
end

function updateAttacks()
	kult_npc.fillAttackList(attacklist, getDatabaseNode());
end

function onLockModeChanged(bReadOnly)
	local tFields = { "nonid_name", "creaturetype", "wounds", "armor", "abilities", "attributes", "combat", "influence", "magic", "attacks", "woundmoves", };
	WindowManager.callSafeControlsSetLockMode(self, tFields, bReadOnly);
end
</LUACode>
