    <LUACode>
function onInit()
	local node = getDatabaseNode();
	if not DB.isOwner(node) or DB.isReadOnly(node) then
		return;
	end
	-- The link opens this row in the move window, with its description
	local _, sRecord = DB.getValue(node, "shortcut", "", "");
	if (sRecord or "") == "" then
		DB.setValue(node, "shortcut", "windowreference", "move", DB.getPath(node));
	end
	-- The basic moves are added without description: take it from the loaded modules
	if manager_kult.trim(DB.getValue(node, "description", "")) == "" then
		local sDescription = kult_results.getModuleMoveDescription(DB.getValue(node, "name", ""));
		if sDescription ~= "" then
			DB.setValue(node, "description", "string", sDescription);
		end
	end
end
</LUACode>
