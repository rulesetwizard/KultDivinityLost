    <LUACode>-- Equipped weapons of the inventory (kult_weapons). Weapons dropped here go to the inventory, equipped.
local aHandlerPaths = {};

function onInit()
	local nodeChar = window.getDatabaseNode();
	kult_weapons.migrateLegacyWeapons(nodeChar);
	if DB.isOwner(nodeChar) and not DB.isReadOnly(nodeChar) then
		kult_weapons.prepareInventory(nodeChar);
	end
	for _,sField in ipairs({ "carried", "type", "kultweapon" }) do
		local sPath = DB.getPath(nodeChar, "inventorylist.*." .. sField);
		DB.addHandler(sPath, "onAdd", onItemChanged);
		DB.addHandler(sPath, "onUpdate", onItemChanged);
		table.insert(aHandlerPaths, sPath);
	end
	applyFilter();
end

function onClose()
	for _,sPath in ipairs(aHandlerPaths) do
		DB.removeHandler(sPath, "onAdd", onItemChanged);
		DB.removeHandler(sPath, "onUpdate", onItemChanged);
	end
end

function onItemChanged()
	applyFilter();
end

function onFilter(w)
	return kult_weapons.isEquippedWeapon(w.getDatabaseNode());
end

function onDrop(x, y, draginfo)
	if draginfo.isType("shortcut") then
		local _, sRecord = draginfo.getShortcutData();
		local nodeSource = DB.findNode(sRecord or "");
		if nodeSource and kult_weapons.addWeapon(window.getDatabaseNode(), nodeSource) then
			applyFilter();
			return true;
		end
	end
end
</LUACode>
