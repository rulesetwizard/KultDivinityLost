    <LUACode>function onInit()
	super.onInit();
	-- An empty Stability means Composed: show it as such on sheets that can be edited
	-- (the field may not exist yet, so it is written through the character node)
	local nodeChar = window.getDatabaseNode();
	if nodeChar and DB.isOwner(nodeChar) and DB.getValue(nodeChar, "stability", "") == "" then
		DB.setValue(nodeChar, "stability", "string", "1");
	end
	setStability();
end

function onValueChanged()
	setStability();
end

-- Level, effects and the limits of the heal/damage buttons
function setStability()
	local nStability = tonumber(getStringValue()) or 1;
	local sLevel = manager_kult.getStressLevel(nStability);
	local sDesc = "";
	local sEffects = "";
	if sLevel ~= "" then
		sDesc = Interface.getString(sLevel);
		sEffects = Interface.getString(sLevel .. "_HELP");
	end
	window.lblStabilityDesc.setValue(sDesc);
	window.lblStabilityEffects.setValue(sEffects);
	window.btnHealStability.setEnabled(nStability &gt; 1);
	window.btnDamageStability.setEnabled(nStability &lt; 10);
end
</LUACode>
