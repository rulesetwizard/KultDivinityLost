<DocumentElement xmlns="http://tempuri.org/Ruleset.xsd">
  <Scripts>
    <ScriptName>data_kult</ScriptName>
    <FolderID>4</FolderID>
    <Script>local moves = {
  ["Keep it Together"] = {attribute="Willpower"},
  ["Endure Injury"] = {attribute="Fortitude"},
  ["Avoid Harm"] = {attribute="Reflexes"},
  ["Investigate"] = {attribute="Reason"},
  ["Read a Person"] = {attribute="Intuition"},
  ["Observe a situation"] = {attribute="Perception"},
  ["Act Under Pressure"] = {attribute="Coolness"},
  ["Engage in Combat"] = {attribute="Violence"},
  ["Influence Other"] = {attribute="Charisma"},
  ["See Through the Illusion"] = {attribute="Soul"},
  ["Helping or Hindering"] = {attribute=""},
}

function getMoves()
    return moves;
end</Script>
    <RegisterScript>true</RegisterScript>
    <Encoding />
  </Scripts>
  <Scripts>
    <ScriptName>kult_npc</ScriptName>
    <FolderID>0</FolderID>
    <Script>-- NPCs: the GM does not roll. NPC attacks are written in the "attacks" text as the rulebook does:
--   Weapon: Attack [Harm] [effect]; Attack [Harm] [effect].
-- An attack posts its Harm to the chat (message type "kultharm"), and so does a successful (10+) weapon attack of a PC.
-- That Harm is dragged onto a combat tracker entry or a portrait: on an NPC it marks Wounds = Harm - armor
-- (rulebook p. 159); on a PC it opens Endure Injury for its player with that Harm.

HARM_TYPE = "kultharm";
OOB_MSGTYPE_ENDURE = "kultendure";

local DOT = " \194\183 ";

function onInit()
	CombatDropManager.setDragTypeDropCallback(HARM_TYPE, onHarmDrop);
	OOBManager.registerOOBMsgHandler(OOB_MSGTYPE_ENDURE, handleEndure);
end

local function trim(s)
	return (s or ""):match("^%s*(.-)%s*$");
end

-- Splits on ";" outside brackets
local function splitAttacks(s)
	local aParts = {};
	local nDepth = 0;
	local nStart = 1;
	for i = 1, #s do
		local c = s:sub(i, i);
		if c == "[" then
			nDepth = nDepth + 1;
		elseif c == "]" then
			nDepth = math.max(0, nDepth - 1);
		elseif c == ";" and nDepth == 0 then
			table.insert(aParts, s:sub(nStart, i - 1));
			nStart = i + 1;
		end
	end
	table.insert(aParts, s:sub(nStart));
	return aParts;
end

-- Attacks of an NPC text: { sWeapon, sName, sHarm, nHarm (nil if the Harm is not a number), sEffect }.
-- Lines without brackets are descriptions and are skipped.
function getAttacks(sText)
	local aAttacks = {};
	for sLine in (sText or ""):gmatch("[^\r\n]+") do
		local nBracket = sLine:find("[", 1, true);
		if nBracket then
			local sWeapon = "";
			local sRest = sLine;
			local nColon = sLine:find(":", 1, true);
			if nColon and nColon &lt; nBracket then
				sWeapon = trim(sLine:sub(1, nColon - 1));
				sRest = sLine:sub(nColon + 1);
			end
			for _,sPart in ipairs(splitAttacks(sRest)) do
				sPart = trim(sPart);
				sPart = sPart:gsub("%.$", "");
				local sName, sBlocks = sPart:match("^([^%[]-)%s*(%[.*)$");
				if sName and trim(sName) ~= "" then
					local aBlocks = {};
					for sBlock in sBlocks:gmatch("%[([^%]]*)%]") do
						table.insert(aBlocks, trim(sBlock));
					end
					local sHarm = aBlocks[1] or "";
					table.remove(aBlocks, 1);
					table.insert(aAttacks, { sWeapon = sWeapon, sName = trim(sName), sHarm = sHarm,
						nHarm = tonumber(sHarm:match("^(%d+)$")), sEffect = table.concat(aBlocks, "; ") });
				end
			end
		end
	end
	return aAttacks;
end

-- Rebuilds a sourceless list of npc_attack windows from the attacks text of an NPC (record or combat tracker entry)
function fillAttackList(wList, nodeNPC)
	if not wList or not nodeNPC then
		return;
	end
	wList.closeAll();
	for _,rAttack in ipairs(getAttacks(DB.getValue(nodeNPC, "attacks", ""))) do
		local w = wList.createWindow();
		if w then
			w.setAttack(nodeNPC, rAttack);
		end
	end
end

-- "Weapon: Attack [Harm 2] [effect]"; without the Harm block if bNoHarm
function getAttackText(rAttack, bNoHarm)
	local sText = rAttack.sName;
	if rAttack.sWeapon ~= "" then
		sText = rAttack.sWeapon .. ": " .. sText;
	end
	if not bNoHarm then
		if rAttack.nHarm then
			sText = sText .. " [" .. string.format(Interface.getString("WEAPON_DAMAGE"), tostring(rAttack.nHarm)) .. "]";
		elseif rAttack.sHarm ~= "" then
			sText = sText .. " [" .. rAttack.sHarm .. "]";
		end
	end
	if rAttack.sEffect ~= "" then
		sText = sText .. " [" .. rAttack.sEffect .. "]";
	end
	return sText;
end

local function getActorName(rActor)
	if not rActor then
		return "";
	end
	return trim(ActorManager.getDisplayName(rActor));
end

-- First line of a Harm message and of a Harm drag: "Harm 2 · What". The chat message shows who as its sender.
function getHarmLine(nHarm, sLabel)
	return string.format(Interface.getString("HARM_LINE"), nHarm, sLabel or "");
end

-- A Harm in the chat that can be dragged onto a target
function sendHarm(rSource, nHarm, sLabel)
	local rMessage = ChatManager.createBaseMessage(rSource);
	rMessage.type = HARM_TYPE;
	rMessage.text = getHarmLine(nHarm, sLabel) .. "\n" .. Interface.getString("HARM_DRAG_HINT");
	rMessage.dice = {};
	rMessage.diemodifier = nHarm;
	Comm.deliverChatMessage(rMessage);
end

-- An NPC attack to the chat: its Harm can be dragged from there
function postAttack(nodeNPC, rAttack)
	if not nodeNPC or not rAttack then
		return;
	end
	local rActor = ActorManager.resolveActor(nodeNPC);
	if rAttack.nHarm then
		sendHarm(rActor, rAttack.nHarm, getAttackText(rAttack, true));
	else
		local rMessage = ChatManager.createBaseMessage(rActor);
		rMessage.text = getAttackText(rAttack);
		Comm.deliverChatMessage(rMessage);
	end
end

-- Drag of an NPC attack straight from its list; the description also says who attacks
function fillHarmDrag(draginfo, nodeNPC, rAttack)
	if not nodeNPC or not rAttack or not rAttack.nHarm then
		return false;
	end
	draginfo.setType(HARM_TYPE);
	draginfo.setIcon("action_damage");
	draginfo.setNumberData(rAttack.nHarm);
	local sLabel = getActorName(ActorManager.resolveActor(nodeNPC)) .. DOT .. getAttackText(rAttack, true);
	draginfo.setDescription(getHarmLine(rAttack.nHarm, sLabel));
	return true;
end

-- A Harm dropped on a combat tracker entry or a portrait
function onHarmDrop(tCustom)
	local draginfo = tCustom.draginfo;
	local nHarm = math.floor(tonumber(draginfo.getNumberData()) or 0);
	local rTarget = ActorManager.resolveActor(tCustom.sTargetPath);
	if not rTarget or nHarm &lt;= 0 then
		return false;
	end
	-- The description of a chat message also has the hint line
	local sSource = (draginfo.getDescription() or ""):match("^[^\n]*") or "";
	if ActorManager.isPC(rTarget) then
		requestEndure(ActorManager.getCreatureNode(rTarget), nHarm, sSource);
		return true;
	end
	-- Only the GM marks the Wounds of NPCs
	if not Session.IsHost then
		return false;
	end
	applyHarm(ActorManager.getCTNode(rTarget), nHarm);
	return true;
end

-- Wounds = Harm - armor, up to the Wounds of the NPC. Only the GM sees the result.
function applyHarm(nodeCT, nHarm)
	if not nodeCT then
		return;
	end
	local nArmor = DB.getValue(nodeCT, "armor", 0);
	local nWounds = math.max(0, nHarm - nArmor);
	local nMax = DB.getValue(nodeCT, "maxWounds", 0);
	local nCurrent = DB.getValue(nodeCT, "wounds", 0) + nWounds;
	if nMax &gt; 0 then
		nCurrent = math.min(nCurrent, nMax);
	end
	DB.setValue(nodeCT, "wounds", "number", nCurrent);

	local sText = string.format(Interface.getString("HARM_NPC"), getActorName(ActorManager.resolveActor(nodeCT)), nWounds, nHarm, nArmor);
	if nMax &gt; 0 then
		sText = sText .. DOT .. nCurrent .. "/" .. nMax;
	end
	if nMax &gt; 0 and nCurrent &gt;= nMax then
		sText = sText .. "\n" .. Interface.getString("HARM_NPC_DEAD");
	elseif nWounds &gt; 0 then
		sText = sText .. "\n" .. Interface.getString("HARM_NPC_MOVE");
	end
	ChatManager.SystemMessage(sText);
end

local function isUserActive(sUser)
	for _,sActive in ipairs(User.getActiveUsers()) do
		if sActive == sUser then
			return true;
		end
	end
	return false;
end

-- Endure Injury goes to the player of the PC; with no player connected, it opens here
function requestEndure(nodeChar, nHarm, sSource)
	if not nodeChar then
		return;
	end
	local sOwner = DB.getOwner(nodeChar) or "";
	if Session.IsHost and sOwner ~= "" and isUserActive(sOwner) then
		Comm.deliverOOBMessage({ type = OOB_MSGTYPE_ENDURE, sChar = DB.getPath(nodeChar), nHarm = tostring(nHarm), sSource = sSource }, sOwner);
		ChatManager.SystemMessage(string.format(Interface.getString("ENDURE_SENT"), trim(DB.getValue(nodeChar, "name", "")), nHarm, sOwner));
		return;
	end
	openEndure(nodeChar, nHarm, sSource);
end

function handleEndure(msgOOB)
	local nodeChar = DB.findNode(msgOOB.sChar or "");
	if nodeChar and DB.isOwner(nodeChar) then
		openEndure(nodeChar, tonumber(msgOOB.nHarm) or 0, msgOOB.sSource or "");
	end
end

function openEndure(nodeChar, nHarm, sSource)
	manager_kult.openRollSetup(nodeChar, { sName = Interface.getString("Endure Injury"), sMove = "endure", sAttribute = "fortitude",
		nHarm = nHarm, sSource = sSource });
end
</Script>
    <RegisterScript>true</RegisterScript>
    <Encoding />
  </Scripts>
  <Scripts>
    <ScriptName>kult_results</ScriptName>
    <FolderID>7</FolderID>
    <Script>-- Reads the results (15+, 10-14, -9) printed in the description of moves, advantages and disadvantages.
-- A description can hold several rolls ("When you build a bomb... / When you disarm a bomb..."): each one is a group.

-- Typographic characters of the module texts, as UTF-8 bytes (this script is not saved as UTF-8)
local EN_DASH = "\226\128\147";
local MINUS = "\226\136\146";
local EM_DASH = "\226\128\148";
local LESS_EQUAL = "\226\137\164";
local BULLET = "\226\128\162";

-- Text after the -9 result that belongs to every result: options, questions, hold...
local aSharedStarts = { "[Oo]pciones[^\n:]*:", "[Oo]ptions[^\n:]*:", "[Pp]reguntas%s*:", "[Qq]uestions%s*:",
	"[Bb]azas%s*:", "[Hh]old%s*:", "\n%s*El director puede gastar", "\n%s*Puedes gastar", "\n%s*Los puntos pueden" };

-- Book references and pointers to the manual are not part of any result
local aTrailers = { "\n%s*Referencia al libro original", "\n%s*Para explicaciones y ejemplos", "\n%s*Reference" };

-- Where a trigger starts inside a longer context
local aTriggerStarts = { "[Ss]iempre que", "[Cc]uando", "[Ww]hen" };

local function trim(s)
	return (s or ""):match("^%s*(.-)%s*$");
end

-- Trims and removes a bullet left alone at the end
local function clean(s)
	s = trim(s);
	while s:sub(-#BULLET) == BULLET do
		s = trim(s:sub(1, -#BULLET - 1));
	end
	return s;
end

local function normalize(s)
	s = s:gsub("\r", ""):gsub(EN_DASH, "-"):gsub(MINUS, "-"):gsub(EM_DASH, "-"):gsub(LESS_EQUAL, "&lt;=");
	for _,sPattern in ipairs(aTrailers) do
		local nStart = s:find(sPattern);
		if nStart then
			s = s:sub(1, nStart - 1);
		end
	end
	return s;
end

local function getBand(sMark)
	local s = sMark:gsub("%s", "");
	if s == "15+" then
		return "high";
	elseif s == "10-14" then
		return "middle";
	elseif s == "-9" or s == "9-" or s == "&lt;=9" then
		return "low";
	end
	return nil;
end

-- Groups of { sContext, nContextStart, tResults = { high, middle, low }, sShared }
function parse(sText)
	local s = normalize(sText or "");

	local aMarks = {};
	for nStart, sBody, nFinish in s:gmatch("()%(([^()]*)%)()") do
		local sBand = getBand(sBody);
		if sBand then
			if s:sub(nStart - 1, nStart - 1) == "[" then
				nStart = nStart - 1;
			end
			if s:sub(nFinish, nFinish) == "]" then
				nFinish = nFinish + 1;
			end
			table.insert(aMarks, { sBand = sBand, nStart = nStart, nFinish = nFinish });
		end
	end

	-- A group is a 15+ mark followed by a 10-14 and a -9 one
	local aGroups = {};
	local i = 1;
	while i &lt;= #aMarks - 2 do
		if aMarks[i].sBand == "high" and aMarks[i + 1].sBand == "middle" and aMarks[i + 2].sBand == "low" then
			table.insert(aGroups, { rHigh = aMarks[i], rMiddle = aMarks[i + 1], rLow = aMarks[i + 2] });
			i = i + 3;
		else
			i = i + 1;
		end
	end

	-- The trigger of a group is the last line before its 15+ mark
	for k,rGroup in ipairs(aGroups) do
		local nPrior = 1;
		if k &gt; 1 then
			nPrior = aGroups[k - 1].rLow.nFinish;
		end
		local sBefore = s:sub(nPrior, rGroup.rHigh.nStart - 1):gsub("%s+$", "");
		local nLastNewline = 0;
		for nPos in sBefore:gmatch("()\n") do
			nLastNewline = nPos;
		end
		rGroup.nContextStart = nPrior + nLastNewline;
		rGroup.sContext = clean(sBefore:sub(nLastNewline + 1));
	end

	for k,rGroup in ipairs(aGroups) do
		local nEnd = #s;
		if aGroups[k + 1] then
			nEnd = aGroups[k + 1].nContextStart - 1;
		end
		local sLow = s:sub(rGroup.rLow.nFinish, nEnd);
		local nShared = nil;
		for _,sPattern in ipairs(aSharedStarts) do
			local nPos = sLow:find(sPattern);
			if nPos and (not nShared or nPos &lt; nShared) then
				nShared = nPos;
			end
		end
		rGroup.sShared = "";
		if nShared then
			rGroup.sShared = clean(sLow:sub(nShared));
			sLow = sLow:sub(1, nShared - 1);
		end
		rGroup.tResults = {
			high = clean(s:sub(rGroup.rHigh.nFinish, rGroup.rMiddle.nStart - 1)),
			middle = clean(s:sub(rGroup.rMiddle.nFinish, rGroup.rLow.nStart - 1)),
			low = clean(sLow),
		};
	end

	return aGroups;
end

-- Description of a move of the loaded modules, for the basic moves added to the sheet without one
function getModuleMoveDescription(sName)
	sName = trim(sName);
	if sName == "" then
		return "";
	end
	for _,node in ipairs(DB.getChildrenGlobal("reference.moves")) do
		if trim(DB.getValue(node, "name", "")) == sName then
			return DB.getValue(node, "description", "");
		end
	end
	return "";
end

function getDescription(node)
	local sDescription = DB.getValue(node, "description", "");
	if trim(sDescription) == "" and DB.getPath(node):find("%.moveslist%.") then
		sDescription = getModuleMoveDescription(DB.getValue(node, "name", ""));
	end
	return sDescription;
end

function getGroups(node)
	if not node then
		return {};
	end
	return parse(getDescription(node));
end

-- Labels for choosing the roll of a description with several groups
function getGroupLabels(node)
	local aLabels = {};
	for k,rGroup in ipairs(getGroups(node)) do
		local sLabel = rGroup.sContext;
		local nTrigger = nil;
		for _,sPattern in ipairs(aTriggerStarts) do
			local nPos = sLabel:find(sPattern);
			if nPos and (not nTrigger or nPos &lt; nTrigger) then
				nTrigger = nPos;
			end
		end
		if nTrigger then
			sLabel = sLabel:sub(nTrigger);
		end
		if #sLabel &gt; 60 then
			-- Cut between characters, not inside a UTF-8 one
			local nCut = 57;
			while nCut &gt; 1 and (sLabel:byte(nCut + 1) or 0) &gt;= 128 and (sLabel:byte(nCut + 1) or 0) &lt; 192 do
				nCut = nCut - 1;
			end
			sLabel = sLabel:sub(1, nCut) .. "...";
		end
		table.insert(aLabels, k .. ". " .. sLabel);
	end
	return aLabels;
end

-- The result text for a roll total, and the trigger when the description has several rolls
function getResult(node, nTotal, nGroup)
	local aGroups = getGroups(node);
	if #aGroups == 0 or (#aGroups &gt; 1 and not nGroup) then
		return nil;
	end
	local rGroup = aGroups[nGroup or 1];
	if not rGroup then
		return nil;
	end
	local sKey = "low";
	if nTotal &gt;= 15 then
		sKey = "high";
	elseif nTotal &gt;= 10 then
		sKey = "middle";
	end
	local sResult = rGroup.tResults[sKey];
	if sResult == "" then
		return nil;
	end
	if rGroup.sShared ~= "" then
		sResult = sResult .. "\n" .. rGroup.sShared;
	end
	local sContext = nil;
	if #aGroups &gt; 1 then
		sContext = rGroup.sContext;
	end
	return sResult, sContext;
end
</Script>
    <RegisterScript>true</RegisterScript>
    <Encoding />
  </Scripts>
  <Scripts>
    <ScriptName>kult_weapons</ScriptName>
    <FolderID>7</FolderID>
    <Script>-- Weapons are inventory items (type Arma / Weapon); the equipped ones (carried = 2) are listed on the main tab.
-- Attacks are read from the item text, as the rulebook writes them after "Ataques:" / "Attacks:":
--   Name [Damage] [effect] [-N ammo]
-- Ammo: "ammo" is the number of boxes and "ammoused" the boxes crossed out (as on the paper sheet).
-- "kultweapon" = 1 marks an item whose damage and ammo were filled from its text.

local aWeaponTypes = { ["arma"] = true, ["armas"] = true, ["weapon"] = true, ["weapons"] = true };

-- Ammo of the rulebook firearms, used when the text gives none
local aKnownCapacity = {
	["pistola"] = 4, ["pistola magnum"] = 3, ["subfusil"] = 3, ["fusil de asalto"] = 4, ["ametralladora"] = 6,
	["fusil"] = 3, ["escopeta de combate"] = 3, ["explosivos"] = 1,
	["handgun"] = 4, ["pistol"] = 4, ["magnum"] = 3, ["magnum handgun"] = 3, ["magnum pistol"] = 3,
	["submachine gun"] = 3, ["assault rifle"] = 4, ["machine gun"] = 6, ["rifle"] = 3,
	["combat shotgun"] = 3, ["shotgun"] = 3, ["explosives"] = 1,
};

-- UTF-8 accented letters of Spanish, to compare names without accents
local aAccents = { ["\195\161"] = "a", ["\195\169"] = "e", ["\195\173"] = "i", ["\195\179"] = "o", ["\195\186"] = "u",
	["\195\188"] = "u", ["\195\177"] = "n", ["\195\129"] = "a", ["\195\137"] = "e", ["\195\141"] = "i", ["\195\147"] = "o",
	["\195\154"] = "u", ["\195\145"] = "n" };

-- Marks of the ammo boxes: white and black circles, squares, and the symbol-font circle of the module (U+F0A1)
local aAmmoMarks = { "\226\151\139", "\226\151\175", "\226\151\143", "\226\150\161", "\226\151\187", "\239\130\161" };

function trim(s)
	return (s or ""):match("^%s*(.-)%s*$");
end

function normalize(s)
	s = trim(s);
	for sFrom, sTo in pairs(aAccents) do
		s = s:gsub(sFrom, sTo);
	end
	return s:lower();
end

-- Code point to UTF-8 (FG's Lua 5.1 has no utf8 library)
local function utf8Char(n)
	if not n or n &lt; 1 then
		return "";
	elseif n &lt; 128 then
		return string.char(n);
	elseif n &lt; 2048 then
		return string.char(192 + math.floor(n / 64), 128 + n % 64);
	elseif n &lt; 65536 then
		return string.char(224 + math.floor(n / 4096), 128 + math.floor(n / 64) % 64, 128 + n % 64);
	end
	return string.char(240 + math.floor(n / 262144), 128 + math.floor(n / 4096) % 64, 128 + math.floor(n / 64) % 64, 128 + n % 64);
end

-- Formatted text to plain text (FG keeps the non-ASCII characters of formatted text as numeric entities)
function plain(s)
	s = (s or ""):gsub("&lt;[^&gt;]*&gt;", " ");
	s = s:gsub("&amp;#[xX](%x+);", function(sHex) return utf8Char(tonumber(sHex, 16)); end);
	s = s:gsub("&amp;#(%d+);", function(sDec) return utf8Char(tonumber(sDec)); end);
	s = s:gsub("&amp;lt;", "&lt;"):gsub("&amp;gt;", "&gt;"):gsub("&amp;quot;", "\""):gsub("&amp;apos;", "'"):gsub("&amp;amp;", "&amp;");
	return trim(s:gsub("%s+", " "));
end

function isWeapon(node)
	if not node then
		return false;
	end
	if DB.getValue(node, "kultweapon", 0) == 1 then
		return true;
	end
	return aWeaponTypes[normalize(DB.getValue(node, "type", ""))] == true;
end

function isEquippedWeapon(node)
	return isWeapon(node) and DB.getValue(node, "carried", 1) == 2;
end

function getText(node)
	for _,sField in ipairs({ "notes", "description", "text" }) do
		local sText = DB.getValue(node, sField, "");
		if type(sText) == "string" and trim(sText) ~= "" then
			return sText;
		end
	end
	return "";
end

-- Paragraphs (or lines) of a formatted text, as plain text
local function getParagraphs(sText)
	local aParagraphs = {};
	for sParagraph in sText:gmatch("&lt;p[^&gt;]*&gt;(.-)&lt;/p&gt;") do
		table.insert(aParagraphs, plain(sParagraph));
	end
	if #aParagraphs == 0 then
		for sLine in sText:gmatch("[^\r\n]+") do
			table.insert(aParagraphs, plain(sLine));
		end
	end
	return aParagraphs;
end

function getRange(node)
	for _,sParagraph in ipairs(getParagraphs(getText(node))) do
		local sRange = sParagraph:match("^[Aa]lcance%s*:%s*(.+)$") or sParagraph:match("^[Rr]ange%s*:%s*(.+)$");
		if sRange then
			return sRange;
		end
	end
	return "";
end

-- Ammo boxes written in the text ("Municion: 3" or box marks); nil if the text gives none
function getTextCapacity(node)
	for _,sParagraph in ipairs(getParagraphs(getText(node))) do
		local sAmount = normalize(sParagraph):match("^municion%s*:%s*(.*)$") or normalize(sParagraph):match("^ammo%s*:%s*(.*)$")
			or normalize(sParagraph):match("^ammunition%s*:%s*(.*)$");
		if sAmount then
			local nAmount = tonumber(sAmount:match("^(%d+)"));
			if nAmount then
				return nAmount;
			end
			local nCount = 0;
			for _,sMark in ipairs(aAmmoMarks) do
				local _, n = sAmount:gsub(sMark, "");
				nCount = nCount + n;
			end
			if nCount &gt; 0 then
				return nCount;
			end
		end
	end
	return nil;
end

-- Attacks of the item: { sName, sDamage, nCost, sEffect }
function getAttacks(node)
	local aAttacks = {};
	local sText = getText(node);
	local nStart = sText:find("[Aa]taques%s*:") or sText:find("[Aa]ttacks%s*:");
	if not nStart then
		return aAttacks;
	end
	local sList = sText:sub(nStart):match("&lt;list[^&gt;]*&gt;(.-)&lt;/list&gt;");
	if not sList then
		return aAttacks;
	end
	for sItem in sList:gmatch("&lt;li[^&gt;]*&gt;(.-)&lt;/li&gt;") do
		local sName, sDamage, sTail = plain(sItem):match("^(.-)%s*%[([^%]]*)%]%s*(.*)$");
		if sName and trim(sName) ~= "" then
			local nCost = 0;
			local aEffects = {};
			for sBlock in sTail:gmatch("%[([^%]]*)%]") do
				local sCost = normalize(sBlock):match("(%d+)%s*municion") or normalize(sBlock):match("(%d+)%s*ammo");
				if sCost then
					nCost = tonumber(sCost) or 0;
				else
					table.insert(aEffects, trim(sBlock));
				end
			end
			table.insert(aAttacks, { sName = trim(sName), sDamage = trim(sDamage), nCost = nCost, sEffect = table.concat(aEffects, "; ") });
		end
	end
	return aAttacks;
end

-- The attacks to choose from when rolling: those of the text, or one with the damage of the sheet
function getRollAttacks(node)
	local aAttacks = getAttacks(node);
	if #aAttacks == 0 then
		local nCost = 0;
		if getCapacity(node) &gt; 0 then
			nCost = 1;
		end
		table.insert(aAttacks, { sName = "", sDamage = tostring(DB.getValue(node, "weapondamage", 0)), nCost = nCost, sEffect = "" });
	end
	return aAttacks;
end

function getCapacity(node)
	return math.max(0, DB.getValue(node, "ammo", 0));
end

function getRemaining(node)
	return math.max(0, getCapacity(node) - DB.getValue(node, "ammoused", 0));
end

-- Fills damage and ammo from the text the first time the item is seen as a weapon; later edits are kept
function prepare(node)
	if not isWeapon(node) or not DB.isOwner(node) or DB.isReadOnly(node) or DB.getValue(node, "kultweapon", 0) == 1 then
		return;
	end
	local aAttacks = getAttacks(node);
	if DB.getValue(node, "weapondamage", 0) == 0 and aAttacks[1] then
		local nDamage = tonumber(aAttacks[1].sDamage:match("^(%d+)"));
		if nDamage then
			DB.setValue(node, "weapondamage", "number", nDamage);
		end
	end
	if getCapacity(node) == 0 then
		local nCapacity = getTextCapacity(node) or aKnownCapacity[normalize(DB.getValue(node, "name", ""))];
		if nCapacity and nCapacity &gt; 0 then
			DB.setValue(node, "ammo", "number", nCapacity);
		end
	end
	DB.setValue(node, "kultweapon", "number", 1);
end

function prepareInventory(nodeChar)
	for _,node in pairs(DB.getChildren(nodeChar, "inventorylist")) do
		prepare(node);
	end
end

-- Crosses out the ammo of an attack; false if there is not enough
function spendAmmo(node, nCost)
	nCost = nCost or 0;
	if nCost &lt;= 0 then
		return true;
	end
	if getRemaining(node) &lt; nCost then
		return false;
	end
	DB.setValue(node, "ammoused", "number", DB.getValue(node, "ammoused", 0) + nCost);
	return true;
end

function reload(node)
	if not node or not DB.isOwner(node) then
		return;
	end
	DB.setValue(node, "ammoused", "number", 0);
	kult_xp.sendChat(DB.getChild(node, "..."), string.format(Interface.getString("WEAPON_RELOADED"), DB.getValue(node, "name", "")));
end

-- Text of an attack for the roll: "Name [Harm 3] [effect]"
function getAttackText(rAttack)
	local sText = "";
	if rAttack.sName ~= "" then
		sText = rAttack.sName .. " ";
	end
	sText = sText .. "[" .. string.format(Interface.getString("WEAPON_DAMAGE"), rAttack.sDamage) .. "]";
	if rAttack.sEffect ~= "" then
		sText = sText .. " [" .. rAttack.sEffect .. "]";
	end
	return sText;
end

-- Label of an attack in the roll setup window
function getAttackLabel(rAttack)
	local sLabel = getAttackText(rAttack);
	if rAttack.nCost &gt; 0 then
		sLabel = sLabel .. " [" .. string.format(Interface.getString("WEAPON_AMMO_COST"), rAttack.nCost) .. "]";
	end
	return sLabel;
end

-- The weapon rows the sheet had before weapons were inventory items become equipped inventory weapons.
-- The old row is kept (marked) so it is never migrated twice.
function migrateLegacyWeapons(nodeChar)
	if not nodeChar or not DB.isOwner(nodeChar) or DB.isReadOnly(nodeChar) then
		return;
	end
	for _,nodeOld in pairs(DB.getChildren(nodeChar, "weapons")) do
		if DB.getValue(nodeOld, "kultmigrated", 0) == 0 then
			local nodeItem = DB.createChild(DB.createChild(nodeChar, "inventorylist"));
			local _, sRecord = DB.getValue(nodeOld, "link", "", "");
			local nodeSource = nil;
			if (sRecord or "") ~= "" then
				nodeSource = DB.findNode(sRecord);
			end
			if nodeSource then
				DB.copyNode(nodeSource, nodeItem);
			end
			local sName = trim(DB.getValue(nodeOld, "name", ""));
			if sName == "" then
				sName = Interface.getString("WEAPON_TYPE");
			end
			DB.setValue(nodeItem, "name", "string", sName);
			DB.setValue(nodeItem, "type", "string", Interface.getString("WEAPON_TYPE"));
			DB.setValue(nodeItem, "count", "number", 1);
			DB.setValue(nodeItem, "carried", "number", 2);
			DB.setValue(nodeItem, "isidentified", "number", 1);
			DB.setValue(nodeItem, "weapondamage", "number", DB.getValue(nodeOld, "weapondamage", 0));
			DB.setValue(nodeItem, "ammo", "number", DB.getValue(nodeOld, "ammo", 0));
			DB.setValue(nodeItem, "ammoused", "number", DB.getValue(nodeOld, "currentAmmo", 0));
			-- The sheet values win over the text
			DB.setValue(nodeItem, "kultweapon", "number", 1);
			DB.setValue(nodeOld, "kultmigrated", "number", 1);
		end
	end
end

-- A weapon dropped on the weapon list goes to the inventory, equipped
function addWeapon(nodeChar, nodeSource)
	if not nodeChar or not nodeSource or not DB.isOwner(nodeChar) or not isWeapon(nodeSource) then
		return false;
	end
	-- Already in this inventory: just equip it
	local sPrefix = DB.getPath(nodeChar, "inventorylist") .. ".";
	if DB.getPath(nodeSource):sub(1, #sPrefix) == sPrefix then
		DB.setValue(nodeSource, "carried", "number", 2);
		return true;
	end
	local nodeItem = DB.createChild(DB.createChild(nodeChar, "inventorylist"));
	DB.copyNode(nodeSource, nodeItem);
	DB.setValue(nodeItem, "count", "number", 1);
	DB.setValue(nodeItem, "carried", "number", 2);
	DB.setValue(nodeItem, "locked", "number", 1);
	DB.setValue(nodeItem, "kultweapon", "number", 0);
	DB.setValue(nodeItem, "ammoused", "number", 0);
	prepare(nodeItem);
	return true;
end

-- Engage in Combat with an equipped weapon: the roll setup window chooses the attack
function openAttack(nodeChar, nodeWeapon)
	if not nodeChar or not nodeWeapon then
		return;
	end
	prepare(nodeWeapon);
	manager_kult.openRollSetup(nodeChar, { sName = Interface.getString("Engage in Combat"), sAttribute = "violence",
		sWeapon = DB.getPath(nodeWeapon), aAttacks = getRollAttacks(nodeWeapon) });
end
</Script>
    <RegisterScript>true</RegisterScript>
    <Encoding />
  </Scripts>
  <Scripts>
    <ScriptName>kult_xp</ScriptName>
    <FolderID>7</FolderID>
    <Script>-- Advancements of the Aware archetypes (rulebook, Experience and character development).
-- Each one costs 5 XP and crosses out a box of the XP tab; options of the second and third groups
-- unlock after 5 and 10 advancements. Options with sGroup raise an attribute up to nCap.
-- Boxes marked by hand before this existed are kept and count as advancements, without charging XP again.

XP_COST = 5;

local aOptions = {
	{ nId = 1, nLimit = 1, nThreshold = 0, sGroup = "any", nCap = 4 },
	{ nId = 2, nLimit = 6, nThreshold = 0, sGroup = "active", nCap = 3 },
	{ nId = 3, nLimit = 2, nThreshold = 0, sGroup = "passive", nCap = 3 },
	{ nId = 4, nLimit = 3, nThreshold = 0 },
	{ nId = 5, nLimit = 2, nThreshold = 5, sGroup = "any", nCap = 4 },
	{ nId = 6, nLimit = 2, nThreshold = 5 },
	{ nId = 7, nLimit = 1, nThreshold = 5 },
	{ nId = 8, nLimit = 1, nThreshold = 5 },
	{ nId = 9, nLimit = 1, nThreshold = 10 },
};
local aPassive = { willpower = true, fortitude = true, reflexes = true };

-- Applied advancements, newest has the highest "order"; used to undo the last one
local HISTORY = "advancementhistory";

function getOptions()
	return aOptions;
end

function getOption(nId)
	nId = tonumber(nId);
	for _,rOption in ipairs(aOptions) do
		if rOption.nId == nId then
			return rOption;
		end
	end
	return nil;
end

function getOptionName(rOption)
	return Interface.getString("charsheet_xp_lblAdv" .. rOption.nId .. "_LabelCaption");
end

-- Single options are a checkbox (advN), the others a counter (advN_current / advN_max)
function getCountField(rOption)
	if rOption.nLimit &gt; 1 then
		return "adv" .. rOption.nId .. "_current";
	end
	return "adv" .. rOption.nId;
end

function getUsed(node, rOption)
	return math.max(0, math.floor(tonumber(DB.getValue(node, getCountField(rOption), 0)) or 0));
end

function getLimit(node, rOption)
	if rOption.nLimit &gt; 1 then
		return math.max(DB.getValue(node, "adv" .. rOption.nId .. "_max", rOption.nLimit), 1);
	end
	return 1;
end

function getTotal(node)
	local nTotal = 0;
	for _,rOption in ipairs(aOptions) do
		nTotal = nTotal + getUsed(node, rOption);
	end
	return nTotal;
end

-- sKey must be an attribute key (willpower...soul) of the option's group
function isAttributeAllowed(rOption, sKey)
	if not rOption or not rOption.sGroup or not sKey or manager_kult.getAttributeKey(sKey) ~= sKey then
		return false;
	end
	if rOption.sGroup == "any" then
		return true;
	end
	if rOption.sGroup == "passive" then
		return aPassive[sKey] == true;
	end
	return not aPassive[sKey];
end

function getAllowedAttributes(rOption)
	local aKeys = {};
	for _,sKey in ipairs(manager_kult.getAttributeKeys()) do
		if isAttributeAllowed(rOption, sKey) then
			table.insert(aKeys, sKey);
		end
	end
	return aKeys;
end

-- Whether the option can be chosen now, and the text explaining it (tooltip of its button)
function getAvailability(node, nId)
	local rOption = getOption(nId);
	if not rOption or not node or not DB.isOwner(node) then
		return false, Interface.getString("XP_NOT_OWNER");
	end
	if getUsed(node, rOption) &gt;= getLimit(node, rOption) then
		return false, Interface.getString("XP_EXHAUSTED");
	end
	if getTotal(node) &lt; rOption.nThreshold then
		return false, string.format(Interface.getString("XP_LOCKED"), rOption.nThreshold);
	end
	if DB.getValue(node, "experiencePoints", 0) &lt; XP_COST then
		return false, string.format(Interface.getString("XP_INSUFFICIENT"), XP_COST);
	end
	return true, string.format(Interface.getString("XP_COST"), XP_COST);
end

-- Checks an attribute for an option: returns the new value, or nil and the reason
function checkAttribute(node, rOption, sKey)
	if not isAttributeAllowed(rOption, sKey) then
		return nil, Interface.getString("XP_CHOOSE_ATTRIBUTE");
	end
	local nValue = DB.getValue(node, sKey, 0);
	if nValue &gt;= rOption.nCap then
		return nil, string.format(Interface.getString("XP_AT_CAP"), manager_kult.signed(rOption.nCap));
	end
	return nValue + 1, nil;
end

function openAdvancement(node, nId)
	local bOk, sMessage = getAvailability(node, nId);
	if not bOk then
		ChatManager.SystemMessage(sMessage);
		return;
	end
	local w = Interface.openWindow("kult_advancement", "");
	if w then
		w.configure(node, nId);
		w.bringToFront();
	end
end

function getAttributeChange(sKey, nBefore, nAfter)
	return string.format(Interface.getString("XP_ATTRIBUTE_CHANGE"), manager_kult.getAttributeName(sKey), manager_kult.signed(nBefore), manager_kult.signed(nAfter));
end

-- Pays the advancement, crosses out its box and raises the attribute; returns true or false and the reason
function applyAdvance(node, nId, sKey)
	local bOk, sMessage = getAvailability(node, nId);
	if not bOk then
		return false, sMessage;
	end
	local rOption = getOption(nId);
	local nBefore, nAfter = nil, nil;
	if rOption.sGroup then
		local sError;
		nAfter, sError = checkAttribute(node, rOption, sKey);
		if not nAfter then
			return false, sError;
		end
		nBefore = DB.getValue(node, sKey, 0);
	else
		sKey = "";
	end

	local nUsed = getUsed(node, rOption);
	local nOrder = 1;
	local nodeLast = getLastAdvance(node);
	if nodeLast then
		nOrder = DB.getValue(nodeLast, "order", 0) + 1;
	end
	local nodeEntry = DB.createChild(DB.createChild(node, HISTORY));
	DB.setValue(nodeEntry, "order", "number", nOrder);
	DB.setValue(nodeEntry, "option", "number", rOption.nId);
	DB.setValue(nodeEntry, "count_before", "number", nUsed);
	DB.setValue(nodeEntry, "attribute", "string", sKey);
	if nAfter then
		DB.setValue(nodeEntry, "value_before", "number", nBefore);
		DB.setValue(node, sKey, "number", nAfter);
	end
	DB.setValue(node, "experiencePoints", "number", DB.getValue(node, "experiencePoints", 0) - XP_COST);
	DB.setValue(node, getCountField(rOption), "number", nUsed + 1);

	local sText = getOptionName(rOption);
	if nAfter then
		sText = getAttributeChange(sKey, nBefore, nAfter);
	end
	sendChat(node, string.format(Interface.getString("XP_CHAT_ADVANCE"), XP_COST, sText));
	return true;
end

function getLastAdvance(node)
	local nodeLast, nLast = nil, -1;
	for _,nodeEntry in pairs(DB.getChildren(node, HISTORY)) do
		local nOrder = DB.getValue(nodeEntry, "order", 0);
		if nOrder &gt; nLast then
			nodeLast, nLast = nodeEntry, nOrder;
		end
	end
	return nodeLast;
end

-- The last advancement can be undone only if its box and attribute are still as it left them
function canUndo(node)
	if not node or not DB.isOwner(node) then
		return false;
	end
	local nodeEntry = getLastAdvance(node);
	if not nodeEntry then
		return false;
	end
	local rOption = getOption(DB.getValue(nodeEntry, "option", 0));
	if not rOption or getUsed(node, rOption) ~= DB.getValue(nodeEntry, "count_before", 0) + 1 then
		return false;
	end
	local sKey = DB.getValue(nodeEntry, "attribute", "");
	return sKey == "" or DB.getValue(node, sKey, 0) == DB.getValue(nodeEntry, "value_before", 0) + 1;
end

-- Text of the last advancement (tooltip of the undo button)
function getLastAdvanceText(node)
	local nodeEntry = getLastAdvance(node);
	if not nodeEntry then
		return "";
	end
	local rOption = getOption(DB.getValue(nodeEntry, "option", 0));
	if not rOption then
		return "";
	end
	local sKey = DB.getValue(nodeEntry, "attribute", "");
	if sKey ~= "" then
		local nBefore = DB.getValue(nodeEntry, "value_before", 0);
		return getAttributeChange(sKey, nBefore, nBefore + 1);
	end
	return getOptionName(rOption);
end

function undoLastAdvance(node)
	if not canUndo(node) then
		ChatManager.SystemMessage(Interface.getString("XP_CANNOT_UNDO"));
		return false;
	end
	local sText = getLastAdvanceText(node);
	local nodeEntry = getLastAdvance(node);
	local rOption = getOption(DB.getValue(nodeEntry, "option", 0));
	local sKey = DB.getValue(nodeEntry, "attribute", "");
	-- The entry goes first, so the sheet refreshes against the remaining history
	local nCountBefore = DB.getValue(nodeEntry, "count_before", 0);
	local nValueBefore = DB.getValue(nodeEntry, "value_before", 0);
	DB.deleteNode(nodeEntry);
	if sKey ~= "" then
		DB.setValue(node, sKey, "number", nValueBefore);
	end
	DB.setValue(node, "experiencePoints", "number", DB.getValue(node, "experiencePoints", 0) + XP_COST);
	DB.setValue(node, getCountField(rOption), "number", nCountBefore);
	sendChat(node, string.format(Interface.getString("XP_CHAT_UNDO"), XP_COST, sText));
	return true;
end

-- Manual corrections of the boxes break the link with the history: it is cleared so nothing old can be undone
function clearHistory(node)
	if node and DB.isOwner(node) then
		local nodeHistory = DB.getChild(node, HISTORY);
		if nodeHistory then
			DB.deleteNode(nodeHistory);
		end
	end
end

function sendChat(node, sText)
	local rMessage = ChatManager.createBaseMessage(ActorManager.resolveActor(node), User.getUsername());
	rMessage.text = sText;
	Comm.deliverChatMessage(rMessage);
end
</Script>
    <RegisterScript>true</RegisterScript>
    <Encoding />
  </Scripts>
  <Scripts>
    <ScriptName>manager_kult</ScriptName>
    <FolderID>0</FolderID>
    <Script>
local aAttributeKeys = { "willpower", "fortitude", "reflexes", "reason", "intuition", "perception", "coolness", "violence", "charisma", "soul" };

-- Help or Hinder move names, besides the one in the active language (older sheets kept these)
local aHelpHinderNames = { "helping or hindering", "ayudar o interferir" };

-- Roll types generated by Ruleset Wizard for the attributes and the move/trait buttons
local aRollTypes = { "btnRollRollAction", "willpowerRollAction", "reflexesRollAction", "fortitudeRollAction", "intuitionRollAction",
	"reasonRollAction", "perceptionRollAction", "violenceRollAction", "coolnessRollAction", "charismaRollAction", "soulRollAction" };

function onInit()
	CombatRecordManager.setRecordTypePostAddCallback("npc", onNPCPostAdd);
	for _,sType in ipairs(aRollTypes) do
		ActionsManager.registerModHandler(sType, modRoll);
	end
end

function onNPCPostAdd(tCustom)
	if not tCustom.nodeRecord or not tCustom.nodeCT then
		return;
	end
	DB.setValue(tCustom.nodeCT, 'maxWounds', 'number', DB.getValue(tCustom.nodeCT, 'wounds', 0));
	DB.setValue(tCustom.nodeCT, 'wounds', 'number', 0);
end

-- Attributes: the key is the charsheet field; the name comes from the attribute_&lt;key&gt; string
function getAttributeKeys()
	return aAttributeKeys;
end

function getAttributeName(sKey)
	return Interface.getString("attribute_" .. sKey);
end

-- Accepts a key, the English name or the name in the active language
function getAttributeKey(sAttribute)
	if (sAttribute or "") == "" then
		return nil;
	end
	local sLower = sAttribute:lower();
	for _,sKey in ipairs(aAttributeKeys) do
		if sLower == sKey or sAttribute == getAttributeName(sKey) then
			return sKey;
		end
	end
	return nil;
end

function getAttributeRollDesc(sKey)
	return string.format(Interface.getString("ROLL_ATTRIBUTE"), getAttributeName(sKey));
end

function isHelpHinderMove(sName)
	if (sName or "") == "" then
		return false;
	end
	local sLower = trim(sName):lower();
	if sLower == Interface.getString("Helping or Hindering"):lower() then
		return true;
	end
	for _,sHelpHinder in ipairs(aHelpHinderNames) do
		if sLower == sHelpHinder then
			return true;
		end
	end
	return false;
end

-- Stability: 1 Composed ... 10 Broken (empty also means Composed)
function getStressLevel(nStability)
	if not nStability then
		return "";
	end
	if nStability &gt;= 10 then
		return "BROKEN";
	elseif nStability &gt;= 7 then
		return "CRITICAL_STRESS";
	elseif nStability &gt;= 4 then
		return "SERIOUS_STRESS";
	elseif nStability &gt;= 2 then
		return "MODERATE_STRESS";
	end
	return "";
end

-- Returns the Keep it Together, Disadvantage roll and See Through the Illusion modifiers
function getStressModifiers(nStability)
	local sLevel = getStressLevel(nStability);
	if sLevel == "CRITICAL_STRESS" then
		return -2, -3, 1;
	elseif sLevel == "SERIOUS_STRESS" then
		return -1, -2, 0;
	elseif sLevel == "MODERATE_STRESS" then
		return 0, -1, 0;
	end
	return 0, 0, 0;
end

-- Kult modifiers of a roll: a list of { sLabel, nValue }.
-- Help or Hinder uses the attribute of the other PC's move, so the attribute's own rules do not apply.
-- nHarm and nArmor come from the roll setup window; without them Endure Injury uses the sheet armor and no Harm.
function getRollModifiers(charNode, sAttribute, bDisadvantage, bHelpHinder, nHarm, nArmor)
	local aMods = {};

	local bSeriousWound = false;
	for i = 1, 4 do
		if (trim(DB.getValue(charNode, "wound" .. i, '')) ~= "") and (DB.getValue(charNode, "wound" .. i .. "sta", 0) == 0) then
			bSeriousWound = true;
		end
	end
	if bSeriousWound then
		table.insert(aMods, { sLabel = Interface.getString("WOUNDED"), nValue = -1 });
	end

	-- A stabilized critical wound counts as a stabilized serious wound
	if (trim(DB.getValue(charNode, "criticalwound", '')) ~= "") and (DB.getValue(charNode, "CriticalWoundStabilized", 0) == 0) then
		table.insert(aMods, { sLabel = Interface.getString("CRITICAL"), nValue = -1 });
	end

	local sAttributeKey = nil;
	if not bHelpHinder then
		sAttributeKey = getAttributeKey(sAttribute);
	end

	-- Endure Injury (the only Fortitude move): +armor -Harm
	if sAttributeKey == "fortitude" then
		local nArmorValue = nArmor or DB.getValue(charNode, "armor", 0);
		if nArmorValue ~= 0 then
			table.insert(aMods, { sLabel = Interface.getString("ARMOR"), nValue = nArmorValue });
		end
		if (nHarm or 0) ~= 0 then
			table.insert(aMods, { sLabel = Interface.getString("HARM"), nValue = -nHarm });
		end
	end

	local nKeepItTogether, nDisadvantage, nSeeThrough = getStressModifiers(tonumber(DB.getValue(charNode, "stability", "")));
	local nStabilityMod = 0;
	if sAttributeKey == "willpower" then
		nStabilityMod = nStabilityMod + nKeepItTogether;
	end
	if sAttributeKey == "soul" then
		nStabilityMod = nStabilityMod + nSeeThrough;
	end
	if bDisadvantage then
		nStabilityMod = nStabilityMod + nDisadvantage;
	end
	if nStabilityMod ~= 0 then
		table.insert(aMods, { sLabel = Interface.getString("STABILITY"), nValue = nStabilityMod });
	end

	return aMods;
end

function signed(n)
	if n &gt;= 0 then
		return "+" .. n;
	end
	return tostring(n);
end

-- The total modifier before rolling and its parts, for tooltips and the roll setup window
function getRollPreview(charNode, sAttribute, bDisadvantage, bHelpHinder, nHarm, nArmor)
	if not charNode then
		return "";
	end
	local sKey = getAttributeKey(sAttribute);
	if bHelpHinder and not sKey then
		return Interface.getString("HELP_HINDER_NO_ATTRIBUTE");
	end
	local nTotal = 0;
	local aParts = {};
	if sKey then
		nTotal = DB.getValue(charNode, sKey, 0);
		table.insert(aParts, getAttributeName(sKey) .. " " .. signed(nTotal));
	end
	local aMods = getRollModifiers(charNode, sAttribute, bDisadvantage, bHelpHinder, nHarm, nArmor);
	for _,rMod in ipairs(aMods) do
		nTotal = nTotal + rMod.nValue;
		table.insert(aParts, rMod.sLabel .. " " .. signed(rMod.nValue));
	end
	local sPreview = "2d10 " .. signed(nTotal);
	if #aParts &gt; 0 then
		sPreview = sPreview .. "\n" .. table.concat(aParts, "; ");
	end
	return sPreview .. "\n" .. Interface.getString("ROLL_PREVIEW_MODSTACK");
end

-- Applies the Kult modifiers before the dice are thrown, so the roll shows them
function modRoll(rSource, rTarget, rRoll)
	local charNode = ActorManager.getCreatureNode(rSource);
	if charNode then
		local aMods = getRollModifiers(charNode, rRoll["attribute"], rRoll["disadvantage"] == "1", isHelpHinderMove(rRoll["move"]),
			tonumber(rRoll["kultharm"]), tonumber(rRoll["kultarmor"]));
		local nTotal = 0;
		local sMods = "";
		for _,rMod in ipairs(aMods) do
			nTotal = nTotal + rMod.nValue;
			sMods = sMods .. " [" .. rMod.sLabel .. " " .. signed(rMod.nValue) .. "]";
		end
		-- A roll can pass through here more than once: replace what was applied before
		rRoll.nMod = (rRoll.nMod or 0) - (tonumber(rRoll.sKultApplied) or 0) + nTotal;
		rRoll.sKultApplied = tostring(nTotal);
		rRoll.sKultDesc = rRoll.sKultDesc or rRoll.sDesc;
		rRoll.sDesc = rRoll.sKultDesc .. sMods;
	end
	-- true keeps the dice expression of Ruleset Wizard rolls ("2d10+attribute")
	return true;
end

-- Opens the roll setup window. rData: sName, sDesc, sMove ("endure", "help" or ""), sAttribute,
-- sRecord (move or trait of the sheet), aGroups (labels of a trait with several rolls), bTrait, bDisadvantage,
-- sWeapon and aAttacks (Engage in Combat with a weapon), nHarm and sSource (Endure Injury from a dropped Harm)
function openRollSetup(nodeChar, rData)
	local w = Interface.openWindow("kult_roll_setup", "");
	if w then
		w.configure(nodeChar, rData);
		-- Opened from a double click on the sheet, which gets the focus back afterwards
		w.bringToFront();
	end
end

-- The roll prepared in the setup window; modRoll adds the Kult modifiers as in any other roll.
-- rData.nDamage and rData.sAttack: Harm and name of a weapon attack, posted to the chat on 10+
function performSetupRoll(nodeChar, rData, sAttributeKey, nHarm, nArmor, nGroup)
	local rRoll = { sType = "btnRollRollAction", sDesc = rData.sDesc or (Interface.getString("ROLL_MOVE") .. " " .. rData.sName),
		aDice = { "d10", "d10" }, nMod = 0, attribute = sAttributeKey or "" };
	if sAttributeKey then
		rRoll.nMod = DB.getValue(nodeChar, sAttributeKey, 0);
	end
	if not rData.bTrait then
		rRoll.move = rData.sName;
	end
	if rData.sRecord then
		rRoll.kultrecord = rData.sRecord;
	end
	if nGroup then
		rRoll.kultresult = tostring(nGroup);
	end
	if rData.bDisadvantage then
		rRoll.disadvantage = "1";
	end
	if nHarm then
		rRoll.kultharm = tostring(nHarm);
		rRoll.kultarmor = tostring(nArmor or 0);
	end
	if rData.nDamage then
		rRoll.kultdamage = tostring(rData.nDamage);
		rRoll.kultattack = rData.sAttack or "";
	end
	ActionsManager.performAction(nil, ActorManager.resolveActor(nodeChar), rRoll);
end

function findMove(charNode, sName)
	for _,node in pairs(DB.getChildren(charNode, "moveslist")) do
		if trim(DB.getValue(node, "name", "")) == trim(sName) then
			return node;
		end
	end
	return nil;
end

-- The move or trait of the sheet whose description holds the results of the roll
function getRollRecord(charNode, rRoll)
	local sRecord = rRoll["kultrecord"] or "";
	if sRecord ~= "" then
		-- Only records of the character that rolls
		local sPrefix = DB.getPath(charNode) .. ".";
		if sRecord:sub(1, #sPrefix) == sPrefix then
			return DB.findNode(sRecord);
		end
		return nil;
	end
	if (rRoll["move"] or "") ~= "" then
		return findMove(charNode, rRoll["move"]);
	end
	-- An attribute roll of the sheet is the basic move of that attribute
	if rRoll.sType ~= "btnRollRollAction" then
		local sKey = getAttributeKey(rRoll["attribute"]);
		for sName, rMove in pairs(data_kult.getMoves()) do
			if sKey and getAttributeKey(rMove.attribute) == sKey then
				return findMove(charNode, Interface.getString(sName)) or findMove(charNode, sName);
			end
		end
	end
	return nil;
end

function resolveRoll(rSource, rTarget, rRoll)

    local rMessage = ActionsManager.createActionMessage(rSource, rRoll);
    
	local total = ActionsManager.total(rRoll); -- the total FG shows in chat (dice, fixed bonus and modifiers)
	local sHelpHinder = "HELP_HINDER_MISS";
    if total &gt;= 15 then
		rMessage.text = rMessage.text .. ' [' .. Interface.getString("COMPLETE SUCCESS") .. ']';
		sHelpHinder = "HELP_HINDER_FULL";
    else
		if total &gt;= 10 then
			rMessage.text = rMessage.text .. ' [' .. Interface.getString("SUCCESS WITH COMPLICATIONS") .. ']';
			sHelpHinder = "HELP_HINDER_PARTIAL";
		else
			rMessage.text = rMessage.text .. ' [' .. Interface.getString("FAILURE") .. ']';
		end
	end
	if isHelpHinderMove(rRoll["move"]) then
		rMessage.text = rMessage.text .. ' [' .. Interface.getString(sHelpHinder) .. ']';
	end

	-- The result text of the move or trait, taken from its description
	local charNode = ActorManager.getCreatureNode(rSource);
	if charNode then
		local sResult, sContext = kult_results.getResult(getRollRecord(charNode, rRoll), total, tonumber(rRoll["kultresult"]));
		if sResult then
			if sContext then
				rMessage.text = rMessage.text .. "\n" .. sContext;
			end
			rMessage.text = rMessage.text .. "\n" .. sResult;
		end
	end
	
    Comm.deliverChatMessage(rMessage);

	-- A weapon attack that hits posts its Harm, to drag onto the target (kult_npc)
	local nDamage = tonumber(rRoll["kultdamage"]);
	if nDamage and total &gt;= 10 then
		kult_npc.sendHarm(rSource, nDamage, rRoll["kultattack"] or "");
	end
end

function trim(s)
   return s:match "^%s*(.-)%s*$"
end
</Script>
    <RegisterScript>true</RegisterScript>
    <Encoding />
  </Scripts>
  <Scripts>
    <ScriptName>npc_roll</ScriptName>
    <FolderID>6</FolderID>
    <Script>local bParsed = false;
local aComponents = {};

local bClicked = false;
local bDragging = false;
local nDragIndex = nil;

function parseComponents()
	aComponents = {};
	
	-- Get the comma-separated strings
	local aClauses, aClauseStats = StringManager.split(getValue(), ",;\r", true);
	
	-- Check each comma-separated string for a potential skill roll or auto-complete opportunity
	for i = 1, #aClauses do
		local nStarts, nEnds, sMod = string.find(aClauses[i], "([d%dF%+%-]+)%s*$");
		if nStarts then
			local sLabel = "";
			if nStarts &gt; 1 then
				sLabel = StringManager.trim(aClauses[i]:sub(1, nStarts - 1));
			end
			local aDice, nMod = StringManager.convertStringToDice(sMod);
			
			-- Insert the possible skill into the skill list
			table.insert(aComponents, {nStart = aClauseStats[i].startpos, nLabelEnd = aClauseStats[i].startpos + nEnds, nEnd = aClauseStats[i].endpos, sLabel = sLabel, aDice = aDice, nMod = nMod });
		end
	end
	
	bParsed = true;
end

function onValueChanged()
	bParsed = false;
end

-- Reset selection when the cursor leaves the control
function onHover(bOnControl)
	if bOnControl then
		return;
	end

	if not bDragging then
		onDragEnd();
	end
end

-- Hilight skill hovered on
function onHoverUpdate(x, y)
	if bDragging or bClicked then
		return;
	end

	if not bParsed then
		parseComponents();
	end
	local nMouseIndex = getIndexAt(x, y);

	for i = 1, #aComponents, 1 do
		if aComponents[i].nStart &lt;= nMouseIndex and aComponents[i].nEnd &gt; nMouseIndex then
			setCursorPosition(aComponents[i].nStart);
			setSelectionPosition(aComponents[i].nEnd);

			nDragIndex = i;
			setHoverCursor("hand");
			return;
		end
	end
	
	nDragIndex = nil;
	setHoverCursor("arrow");
end

function action(draginfo)
	if nDragIndex then
		if draginfo then
			if #(aComponents[nDragIndex].aDice) &gt; 0 then
				local rRoll = { sType = "dice", sDesc = aComponents[nDragIndex].sLabel, aDice = aComponents[nDragIndex].aDice, nMod = aComponents[nDragIndex].nMod };
				ActionsManager.performAction(draginfo, nil, rRoll);
			else
				local rRoll = { sType = "dice", sDesc = aComponents[nDragIndex].sLabel, aDice = "2d10", nMod = aComponents[nDragIndex].nMod };
				ActionsManager.performAction(draginfo, nil, rRoll);
			end
		else
			if #(aComponents[nDragIndex].aDice) &gt; 0 then
				local rRoll = { sType = "dice", sDesc = aComponents[nDragIndex].sLabel, aDice = aComponents[nDragIndex].aDice, nMod = aComponents[nDragIndex].nMod };
				ActionsManager.performAction(nil, nil, rRoll);
			else
				local rRoll = { sType = "dice", sDesc = aComponents[nDragIndex].sLabel, aDice = "2d10", nMod = aComponents[nDragIndex].nMod };
				ActionsManager.performAction(nil, nil, rRoll);
			end
		end
	end
end

function onDoubleClick(x, y)
	action();
	return true;
end

function onDragStart(button, x, y, draginfo)
	action(draginfo);

	bClicked = false;
	bDragging = true;
	
	return true;
end

function onDragEnd(draginfo)
	bClicked = false;
	bDragging = false;
	nDragIndex = nil;
	setHoverCursor("arrow");
	setCursorPosition(0);
	setSelectionPosition(0);
end

-- Suppress default processing to support dragging
function onClickDown(button, x, y)
	bClicked = true;
	return true;
end

-- On mouse click, set focus, set cursor position and clear selection
function onClickRelease(button, x, y)
	bClicked = false;
	setFocus();
	
	local n = getIndexAt(x, y);
	setSelectionPosition(n);
	setCursorPosition(n);
	
	return true;
end
</Script>
    <RegisterScript>false</RegisterScript>
    <Encoding />
  </Scripts>
  <Scripts>
    <ScriptName>SideBarData</ScriptName>
    <FolderID>8</FolderID>
    <Script>function onInit()

	aRecordOverrides = {
		["move"] = { 
			bExport = true,
			aDataMap = { "reference.moves" }, 
			sRecordDisplayClass = "move", 
			sSidebarCategory  = "player",
		},		
		["advantage"] = { 
			bExport = true,
			aDataMap = { "reference.advantages" }, 
			sRecordDisplayClass = "advantagedisadvantage", 
			sSidebarCategory  = "player",
		},		
		["disadvantage"] = { 
			bExport = true,
			aDataMap = { "reference.disadvantages" }, 
			sRecordDisplayClass = "advantagedisadvantage", 
			sSidebarCategory  = "player",
		},		
		["archetype"] = { 
			bExport = true,
			aDataMap = { "reference.archetypes" }, 
			sRecordDisplayClass = "archetype", 
			sSidebarCategory  = "player",
		},	
		["darksecret"] = { 
			bExport = true,
			aDataMap = { "reference.darksecrets" }, 
			sRecordDisplayClass = "darksecret", 
			sSidebarCategory  = "player",
		},					
	}
	
	LibraryData.overrideRecordTypes(aRecordOverrides);

	if User.isHost() then
		local moves = DB.findNode("reference.moves");
		if moves then
			moves.setPublic(true);
		end
		local advantages = DB.findNode("reference.advantages");
		if advantages then
			advantages.setPublic(true);
		end
		local disadvantages = DB.findNode("reference.disadvantages");
		if disadvantages then
			disadvantages.setPublic(true);
		end
		local archetypes = DB.findNode("reference.archetypes");
		if archetypes then
			archetypes.setPublic(true);
		end
		local darksecrets = DB.findNode("reference.darksecrets");
		if darksecrets then
			darksecrets.setPublic(true);
		end		
	end		
end</Script>
    <RegisterScript>true</RegisterScript>
    <Encoding />
  </Scripts>
</DocumentElement>

<DocumentElement xmlns="http://tempuri.org/Ruleset.xsd">
  <XMLFiles>
    <XmlName>npc_record</XmlName>
    <FolderID>6</FolderID>
    <XML>&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;root&gt;
	&lt;!-- CoreRPG's npc with a Description tab for the record text the modules bring (field "text"); Notes stays for the GM --&gt;
	&lt;windowclass name="npc" copy="record_window_tabbed"&gt;
		&lt;minimize&gt;minimized_npc&lt;/minimize&gt;
		&lt;gmexport&gt;npc&lt;/gmexport&gt;
		&lt;tab&gt;
			&lt;name&gt;main&lt;/name&gt;
			&lt;resource&gt;tab_main&lt;/resource&gt;
			&lt;class&gt;npc_main&lt;/class&gt;
			&lt;embed /&gt;
		&lt;/tab&gt;
		&lt;tab merge="add"&gt;
			&lt;name&gt;description&lt;/name&gt;
			&lt;resource&gt;tab_description&lt;/resource&gt;
			&lt;class&gt;record_content_text&lt;/class&gt;
			&lt;embed /&gt;
		&lt;/tab&gt;
		&lt;tab merge="add"&gt;
			&lt;name&gt;notes&lt;/name&gt;
			&lt;resource&gt;tab_notes&lt;/resource&gt;
			&lt;class&gt;record_content_notes&lt;/class&gt;
			&lt;embed /&gt;
		&lt;/tab&gt;
		&lt;tab merge="add"&gt;
			&lt;name&gt;pictures&lt;/name&gt;
			&lt;resource&gt;tab_pictures&lt;/resource&gt;
			&lt;class&gt;record_content_pictures&lt;/class&gt;
			&lt;embed /&gt;
		&lt;/tab&gt;
	&lt;/windowclass&gt;
&lt;/root&gt;
</XML>
  </XMLFiles>
  <XMLFiles>
    <XmlName>SidebarStrings</XmlName>
    <FolderID>8</FolderID>
    <XML>&lt;?xml version="1.0" encoding="iso-8859-1"?&gt;
&lt;root&gt;
	&lt;string name="library_recordtype_label_move"&gt;Moves&lt;/string&gt;	
	&lt;string name="library_recordtype_label_advantage"&gt;Advantages&lt;/string&gt;	
	&lt;string name="library_recordtype_label_disadvantage"&gt;Disadvantages&lt;/string&gt;		
	&lt;string name="library_recordtype_label_archetype"&gt;Archetypes&lt;/string&gt;	
	&lt;string name="library_recordtype_label_darksecret"&gt;Dark Secrets&lt;/string&gt;		
&lt;/root&gt;</XML>
  </XMLFiles>
  <XMLFiles>
    <XmlName>strings_kult</XmlName>
    <FolderID>4</FolderID>
    <XML>&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;root&gt;
  &lt;string name="Keep it Together"&gt;Keep it Together&lt;/string&gt;
  &lt;string name="Endure Injury"&gt;Endure Injury&lt;/string&gt;
  &lt;string name="Avoid Harm"&gt;Avoid Harm&lt;/string&gt;
  &lt;string name="Investigate"&gt;Investigate&lt;/string&gt;
  &lt;string name="Read a Person"&gt;Read a Person&lt;/string&gt;
  &lt;string name="Observe a situation"&gt;Observe a situation&lt;/string&gt;
  &lt;string name="Act Under Pressure"&gt;Act Under Pressure&lt;/string&gt;
  &lt;string name="Engage in Combat"&gt;Engage in Combat&lt;/string&gt;
  &lt;string name="Influence Other"&gt;Influence Other&lt;/string&gt;
  &lt;string name="See Through the Illusion"&gt;See Through the Illusion&lt;/string&gt;
  &lt;string name="Helping or Hindering"&gt;Helping or Hindering&lt;/string&gt;

  &lt;string name="attribute_willpower"&gt;Willpower&lt;/string&gt;
  &lt;string name="attribute_fortitude"&gt;Fortitude&lt;/string&gt;
  &lt;string name="attribute_reflexes"&gt;Reflexes&lt;/string&gt;
  &lt;string name="attribute_reason"&gt;Reason&lt;/string&gt;
  &lt;string name="attribute_intuition"&gt;Intuition&lt;/string&gt;
  &lt;string name="attribute_perception"&gt;Perception&lt;/string&gt;
  &lt;string name="attribute_coolness"&gt;Coolness&lt;/string&gt;
  &lt;string name="attribute_violence"&gt;Violence&lt;/string&gt;
  &lt;string name="attribute_charisma"&gt;Charisma&lt;/string&gt;
  &lt;string name="attribute_soul"&gt;Soul&lt;/string&gt;
