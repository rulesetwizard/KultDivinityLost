    <LUACode>
function onInit()
	local node = getDatabaseNode();
	-- The link opens this entry's own copy in the advantage/disadvantage window
	if DB.isOwner(node) and not DB.isReadOnly(node) then
		local _, sRecord = DB.getValue(node, "link", "", "");
		if (sRecord or "") == "" then
			DB.setValue(node, "link", "windowreference", "advantagedisadvantage", DB.getPath(node));
		end
	end
	DB.addHandler(DB.getPath(node, "rollable"), "onUpdate", setRollVisible);
end

function onFirstLayout()
	setRollVisible();
end

function onClose()
	DB.removeHandler(DB.getPath(getDatabaseNode(), "rollable"), "onUpdate", setRollVisible);
end

function setRollVisible()
	btnRoll.setVisible(DB.getValue(getDatabaseNode(), "rollable", 0) == 1);
end
</LUACode>
