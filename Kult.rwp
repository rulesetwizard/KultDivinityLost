    <LUACode>
function getAttributeKey()
	return manager_kult.getAttributeKey(DB.getValue(window.getDatabaseNode(), "attribute", ""));
end

function getAttributeValue()
	local sKey = getAttributeKey();
	if sKey then
		return DB.getValue(window.windowlist.window.getDatabaseNode(), sKey, 0);
	end
	return 0;
end

-- Attribute name in the active language, for the roll description
function getAttributeSuffix()
	local sKey = getAttributeKey();
	if sKey then
		return " (" .. manager_kult.getAttributeName(sKey) .. ")";
	end
	return "";
end

-- The roll carries this trait, whose description gives the result text.
-- A trait with several rolls asks which one first.
function onBeforeDiceRoll(dragInfo)
	local node = window.getDatabaseNode();
	local aLabels = kult_results.getGroupLabels(node);
	if #aLabels &gt; 1 then
		manager_kult.openRollSetup(window.windowlist.window.getDatabaseNode(), { sName = DB.getValue(node, "name", ""),
			sDesc = DB.getValue(node, "name", "") .. getAttributeSuffix(), sAttribute = DB.getValue(node, "attribute", ""),
			sRecord = DB.getPath(node), aGroups = aLabels, bTrait = true, bDisadvantage = (DB.getValue(node, "isdisadvantage", 0) == 1) });
		return false;
	end
	DiceRollAdditionalInfo["kultrecord"] = DB.getPath(node);
	return true;
end

-- Tooltip with the modifier the roll will have
function onHover(bOnControl)
	if bOnControl then
		local node = window.getDatabaseNode();
		setTooltipText(manager_kult.getRollPreview(window.windowlist.window.getDatabaseNode(), DB.getValue(node, "attribute", ""), DB.getValue(node, "isdisadvantage", 0) == 1));
	end
end</LUACode>
