    <LUACode>local aWoundFields = { "wound1", "wound2", "wound3", "wound4", "criticalwound" };
local aWoundStateFields = { "wound1sta", "wound2sta", "wound3sta", "wound4sta", "CriticalWoundStabilized" };
local bEditAttributes = false;

function onInit()
	local node = getDatabaseNode();
	for _,sField in ipairs(aWoundFields) do
		DB.addHandler(DB.getPath(node, sField), "onUpdate", onWoundsChanged);
	end
	for _,sField in ipairs(aWoundStateFields) do
		DB.addHandler(DB.getPath(node, sField), "onUpdate", onWoundsChanged);
	end
	onWoundsChanged();
	btnEditAttributes.setVisible(DB.isOwner(node));
	setAttributesEditable(false);
end

function onClose()
	local node = getDatabaseNode();
	for _,sField in ipairs(aWoundFields) do
		DB.removeHandler(DB.getPath(node, sField), "onUpdate", onWoundsChanged);
	end
	for _,sField in ipairs(aWoundStateFields) do
		DB.removeHandler(DB.getPath(node, sField), "onUpdate", onWoundsChanged);
	end
end

function onWoundsChanged()
	calcWounds();
	updateWoundControls();
end

-- Serious wounds plus the critical wound (shown in the CT against a maximum of 5)
function calcWounds()
	local node = getDatabaseNode();
	if not DB.isOwner(node) then
		return;
	end
	local nWounds = 0;
	for _,sField in ipairs(aWoundFields) do
		if manager_kult.trim(DB.getValue(node, sField, '')) ~= "" then 
			nWounds = nWounds + 1;
		end
	end
	wounds.setValue(nWounds);
end

-- A wound can only be stabilized once it is written; the penalty is the one the rolls apply
function updateWoundControls()
	local node = getDatabaseNode();
	local bOwner = DB.isOwner(node);
	for i = 1, 4 do
		self["wound" .. i .. "sta"].setReadOnly(not bOwner or manager_kult.trim(DB.getValue(node, "wound" .. i, '')) == "");
	end
	CriticalWoundStabilized.setReadOnly(not bOwner or manager_kult.trim(DB.getValue(node, "criticalwound", '')) == "");

	local aMods = manager_kult.getRollModifiers(node, "", false, false);
	local nPenalty = 0;
	local aParts = {};
	for _,rMod in ipairs(aMods) do
		nPenalty = nPenalty + rMod.nValue;
		table.insert(aParts, rMod.sLabel .. " " .. manager_kult.signed(rMod.nValue));
	end
	if nPenalty == 0 then
		lblWoundPenalty.setValue("");
		lblWoundPenalty.setTooltipText("");
	else
		lblWoundPenalty.setValue(manager_kult.signed(nPenalty));
		lblWoundPenalty.setTooltipText(string.format(Interface.getString("WOUND_PENALTY"), manager_kult.signed(nPenalty)) .. "\n" .. table.concat(aParts, "; "));
	end
end

-- Attributes are read-only until Edit is pressed, so a click or the mouse wheel cannot change them
function setAttributesEditable(bEdit)
	bEditAttributes = bEdit and DB.isOwner(getDatabaseNode());
	for _,sKey in ipairs(manager_kult.getAttributeKeys()) do
		self[sKey].setReadOnly(not bEditAttributes);
	end
	if bEditAttributes then
		btnEditAttributes.setText(Interface.getString("ATTRIBUTES_DONE"));
	else
		btnEditAttributes.setText(Interface.getString("ATTRIBUTES_EDIT"));
	end
end

function toggleAttributesEditable()
	setAttributesEditable(not bEditAttributes);
end
</LUACode>
