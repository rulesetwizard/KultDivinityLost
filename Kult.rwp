    <LUACode>function addEntry(bFocus)
	local w = createWindow();
	w.name.setFocus();
	return w;
end

function update()
	local sEdit = getName() .. "_iedit";
	if window[sEdit] then
		local bEdit = (window[sEdit].getValue() == 1);
		for _,w in ipairs(getWindows()) do
			w.idelete.setVisibility(bEdit);
		end
	end
end

-- Copy dropped advantages/disadvantages, marking the ones from the Disadvantages library
function onDrop(x, y, draginfo)
	if not draginfo.isType("shortcut") then
		return false;
	end
	local sClass, sRecord = draginfo.getShortcutData();
	if sClass ~= "advantagedisadvantage" then
		return false;
	end
	local nodeSource = DB.findNode(sRecord);
	if not nodeSource then
		return true;
	end
	local nodeNew = DB.createChild(getDatabaseNode());
	DB.copyNode(nodeSource, nodeNew);
	if sRecord:match("disadvantage") then
		DB.setValue(nodeNew, "isdisadvantage", "number", 1);
	end
	DB.setValue(nodeNew, "link", "windowreference", "advantagedisadvantage", DB.getPath(nodeNew));
	return true;
end</LUACode>
