    <LUACode>
function onInit()
	-- Records of the Disadvantages library are disadvantages
	local node = getDatabaseNode();
	if DB.isOwner(node) and not DB.isReadOnly(node) and DB.getPath(node):match("disadvantage") then
		if DB.getValue(node, "isdisadvantage", 0) == 0 then
			DB.setValue(node, "isdisadvantage", "number", 1);
		end
	end
	update();
	updateEmptyText();
end

function onLockChanged()
	update();
end
			
function update()

	local bReadOnly = WindowManager.getReadOnlyState(getDatabaseNode());
	name.setReadOnly(bReadOnly);
	attribute.setComboBoxReadOnly(bReadOnly);
	rollable.setReadOnly(bReadOnly);
	isdisadvantage.setReadOnly(bReadOnly);
	description.setReadOnly(bReadOnly);
end

function updateEmptyText()
	if isdisadvantage.getValue() == 1 then
		name.setEmptyText(Interface.getString("advantagedisadvantage_name_EmptyText_Disadvantage"));
	else
		name.setEmptyText(Interface.getString("advantagedisadvantage_name_EmptyText"));
	end
end</LUACode>
