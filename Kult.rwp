    <LUACode>function onButtonPress()
	local stability = window.stability.getStringValue();
	local nstability = tonumber(stability);
	-- Empty means Composed (1)
	if nstability == nil then
		nstability = 1;
	end
	if nstability &lt; 10 then
		nstability = nstability + 1;
		window.stability.setStringValue(''..nstability);
	end
end
</LUACode>
