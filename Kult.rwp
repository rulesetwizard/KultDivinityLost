    <LUACode>function onInit()
	super.onInit();
	add("", "");
	for _,sKey in ipairs(manager_kult.getAttributeKeys()) do
		add(sKey, manager_kult.getAttributeName(sKey));
	end
	-- Records saved in another language show the name in the active one
	local sValue = getValue();
	local sKey = manager_kult.getAttributeKey(sValue);
	if sKey and sValue ~= manager_kult.getAttributeName(sKey) then
		local node = getDatabaseNode();
		if node and DB.isOwner(node) and not DB.isReadOnly(node) then
			setListValue(manager_kult.getAttributeName(sKey));
		end
	end
end
